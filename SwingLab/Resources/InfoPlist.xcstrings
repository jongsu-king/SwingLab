{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab uses your camera to record golf swings for analysis on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab은 이 iPhone에서 골프 스윙을 촬영하고 분석하기 위해 카메라를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLabは、このiPhoneでゴルフスイングを撮影・分析するためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 使用相机录制高尔夫挥杆，并在此 iPhone 上进行分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 使用相機錄製高爾夫揮桿，並在此 iPhone 上進行分析。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab usa la cámara para grabar swings de golf y analizarlos en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SwingLab usa a câmera para gravar swings de golfe e analisá-los neste iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab verwendet die Kamera, um Golfschwünge aufzunehmen und auf diesem iPhone zu analysieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab utilise la caméra pour filmer vos swings et les analyser sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab usa la fotocamera per registrare gli swing di golf e analizzarli su questo iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab ใช้กล้องบันทึกวงสวิงกอล์ฟเพื่อวิเคราะห์บน iPhone เครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab dùng camera để ghi lại cú swing và phân tích trên iPhone này."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab uses your location while the course screen is open to calculate target distances and record shots you choose to save."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab은 코스 화면이 열려 있을 때 위치를 사용하여 목표 지점까지의 거리를 계산하고 사용자가 저장한 샷을 기록합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLabはコース画面を開いている間、位置情報を使って目標までの距離を計算し、保存したショットを記録します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 在球场界面打开时使用您的位置，计算目标距离并记录您选择保存的击球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 在球場畫面開啟時使用您的位置，計算目標距離並記錄您選擇儲存的擊球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab usa tu ubicación mientras la pantalla del campo está abierta para calcular distancias al objetivo y registrar los golpes que decides guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SwingLab usa sua localização enquanto a tela do campo está aberta para calcular distâncias ao alvo e registrar as tacadas que você escolhe salvar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab nutzt deinen Standort bei geöffneter Platzansicht, um Zielentfernungen zu berechnen und ausgewählte Schläge zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab utilise votre position lorsque la vue du parcours est ouverte pour calculer les distances et enregistrer les coups que vous choisissez de sauvegarder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab usa la posizione mentre la schermata del campo è aperta per calcolare le distanze e registrare i colpi che scegli di salvare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab ใช้ตำแหน่งเมื่อเปิดหน้าสนาม เพื่อคำนวณระยะถึงเป้าหมายและบันทึกช็อตที่คุณเลือกบันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab dùng vị trí khi màn hình sân golf đang mở để tính khoảng cách đến mục tiêu và ghi lại những cú đánh bạn chọn lưu."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab records sound with your swing videos to time the moment of impact on this iPhone. Sound is not uploaded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab은 이 iPhone에서 임팩트 순간을 측정하기 위해 스윙 영상과 함께 소리를 녹음합니다. 소리는 업로드되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLabは、このiPhone上でインパクトの瞬間を計時するため、スイング動画と一緒に音声を録音します。音声はアップロードされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 会在录制挥杆视频时同时录音，以便在这台 iPhone 上测定击球时刻。声音不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab 會在錄製揮桿影片時同時錄音，以便在這台 iPhone 上測定擊球時刻。聲音不會上傳。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab graba sonido con tus videos de swing para medir el momento del impacto en este iPhone. El sonido no se sube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SwingLab grava som com seus vídeos de swing para cronometrar o momento do impacto neste iPhone. O som não é enviado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab nimmt mit deinen Schwungvideos Ton auf, um den Treffmoment auf diesem iPhone zu bestimmen. Der Ton wird nicht hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab enregistre le son avec vos vidéos de swing pour chronométrer l’instant de l’impact sur cet iPhone. Le son n’est pas envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab registra l’audio insieme ai video dello swing per misurare il momento dell’impatto su questo iPhone. L’audio non viene caricato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab บันทึกเสียงพร้อมวิดีโอสวิงเพื่อจับเวลาช่วงกระทบลูกบน iPhone เครื่องนี้ เสียงจะไม่ถูกอัปโหลด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SwingLab ghi âm cùng video swing để xác định thời điểm chạm bóng trên iPhone này. Âm thanh không được tải lên."
          }
        }
      }
    }
  },
  "version": "1.0"
}
