    "Add carry and both variability values in My Bag to compare clubs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add carry and both variability values in My Bag to compare clubs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클럽을 비교하려면 내 골프백에서 캐리와 앞뒤·좌우 편차를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラブを比較するには、マイバッグでキャリーと前後・左右のばらつきを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球包中输入空中距离及前后、左右离散值，即可比较球杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球袋中輸入空中距離及前後、左右離散值，即可比較球桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el vuelo y ambas variabilidades en Mi bolsa para comparar palos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o carry e as duas variabilidades em Minha bolsa para comparar tacos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Vergleich Carry und beide Streuwerte in Meine Tasche eintragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseignez la portée et les deux dispersions dans Mon sac pour comparer les clubs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci carry e le due variabilità in La mia sacca per confrontare i bastoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มแคร์รี่และความแปรปรวนสองแนวในถุงกอล์ฟของฉันเพื่อเปรียบเทียบไม้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập carry và độ biến thiên theo hai hướng trong Túi gậy để so sánh gậy."
          }
        }
      }
    },
    "Add carry and lateral variability in My Bag to show probability regions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add carry and lateral variability in My Bag to show probability regions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확률 영역을 표시하려면 내 골프백에서 캐리·좌우 편차를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確率領域を表示するには、マイバッグで前後・左右のばらつきを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球包中输入前后和左右离散值以显示概率区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球袋中輸入前後和左右離散值以顯示機率區域。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade variabilidad de vuelo y lateral en Mi bolsa para mostrar regiones de probabilidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione variabilidade de carry e lateral em Minha bolsa para mostrar regiões de probabilidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry- und Seitenstreuung in Meine Tasche für Wahrscheinlichkeitsbereiche eintragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les dispersions en portée et latérale dans Mon sac pour afficher les régions de probabilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi variabilità di carry e laterale in La mia sacca per mostrare le regioni di probabilità."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มความแปรปรวนแคร์รี่และด้านข้างในถุงกอล์ฟของฉันเพื่อแสดงบริเวณความน่าจะเป็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm độ biến thiên carry và ngang trong Túi gậy để hiện vùng xác suất."
          }
        }
      }
    },
