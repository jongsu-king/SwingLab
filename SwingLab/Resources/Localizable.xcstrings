        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄已刪除，但影片檔案未能清除。請在設定中使用「刪除全部本機資料」重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el registro, pero no el vídeo. Reintenta con Eliminar todos los datos locales en Ajustes."
