      }
    },
    "The camera stopped. Close the camera and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera stopped. Close the camera and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 중지되었습니다. 카메라를 닫고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが停止しました。閉じてから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
