    },
    "The sound track could not be read, so impact is a pose estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound track could not be read, so impact is a pose estimate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 트랙을 읽을 수 없어 임팩트는 자세 기반 추정입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックを読み取れなかったため、インパクトは姿勢からの推定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取音轨，击球时刻为姿态估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取音軌，擊球時刻為姿態估算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la pista de sonido, así que el impacto es una estimación por postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a faixa de áudio, então o impacto é uma estimativa pela postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur konnte nicht gelesen werden, daher ist der Treffmoment eine Schätzung aus der Haltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste audio n’a pas pu être lue ; l’impact est une estimation d’après la posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere la traccia audio, quindi l’impatto è una stima dalla postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านแทร็กเสียงไม่ได้ จังหวะกระทบจึงเป็นค่าประมาณจากท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được rãnh âm thanh, nên thời điểm chạm bóng là ước tính từ tư thế."
          }
        }
      }
    },
    "The strike was heard, but the frames around it were not all captured. Wait a moment after setting the ball, then hit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strike was heard, but the frames around it were not all captured. Wait a moment after setting the ball, then hit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타구음은 잡혔지만 그 전후 프레임이 다 담기지 않았어요. 공 위치를 지정하고 잠시 뒤에 치세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打球音は検出しましたが、前後のフレームがすべて取得できませんでした。ボール位置を指定してから少し待って打ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听到了击球声，但前后的画面没有全部捕获。设定球的位置后稍等片刻再击球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽到了擊球聲，但前後的畫面沒有全部擷取。設定球的位置後稍等片刻再擊球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oyó el golpe, pero no se capturaron todos los fotogramas a su alrededor. Espera un momento tras fijar la bola y golpea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tacada foi ouvida, mas nem todos os quadros ao redor foram capturados. Aguarde um instante após definir a bola e dê a tacada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlag wurde gehört, aber nicht alle Bilder davor und danach wurden erfasst. Nach dem Festlegen des Balls kurz warten, dann schlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La frappe a été entendue, mais toutes les images autour n'ont pas été capturées. Attendez un instant après avoir placé la balle, puis frappez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colpo è stato sentito, ma non tutti i fotogrammi attorno sono stati acquisiti. Attendi un momento dopo aver impostato la palla, poi colpisci."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้ยินเสียงตีลูกแล้ว แต่เก็บเฟรมรอบ ๆ ได้ไม่ครบ หลังกำหนดตำแหน่งลูกให้รอสักครู่แล้วจึงตี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nghe tiếng đánh nhưng không ghi đủ các khung hình xung quanh. Hãy đợi một chút sau khi đặt bóng rồi đánh."
          }
        }
      }
    },
    "The system picker gives SwingLab access only to videos you choose. Imported copies remain in SwingLab until you delete them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system picker gives SwingLab access only to videos you choose. Imported copies remain in SwingLab until you delete them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 선택기는 선택한 영상에만 SwingLab 접근을 허용합니다. 가져온 사본은 직접 삭제할 때까지 SwingLab에 보관됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの選択画面では選んだ動画にだけアクセスします。読み込んだコピーは削除するまでSwingLabに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统选择器仅允许 SwingLab 访问你选择的视频。导入的副本保留在 SwingLab 中，直到你将其删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統選擇器僅允許 SwingLab 存取你選擇的影片。匯入的副本保留在 SwingLab 中，直到你將其刪除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector del sistema solo da acceso a los vídeos que eliges. Las copias importadas permanecen en SwingLab hasta que las elimines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seletor do sistema dá acesso apenas aos vídeos escolhidos. Cópias importadas ficam no SwingLab até você excluí-las."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemauswahl gewährt nur Zugriff auf gewählte Videos. Importierte Kopien bleiben in SwingLab, bis du sie löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur système donne accès uniquement aux vidéos choisies. Les copies importées restent dans SwingLab jusqu’à leur suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il selettore di sistema consente l’accesso solo ai video scelti. Le copie importate restano in SwingLab finché non le elimini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกของระบบให้เข้าถึงเฉพาะวิดีโอที่คุณเลือก สำเนาที่นำเข้าจะอยู่ใน SwingLab จนกว่าคุณจะลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ chọn hệ thống chỉ cho truy cập video bạn chọn. Bản sao nhập vào ở trong SwingLab đến khi bạn xóa."
          }
        }
      }
    },
    "The trace is image-space motion of the selected region. It does not measure club speed, ball launch or impact. Nothing is drawn after tracking loss.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trace is image-space motion of the selected region. It does not measure club speed, ball launch or impact. Nothing is drawn after tracking loss."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궤적은 선택한 영역의 영상 내 움직임입니다. 클럽 속도, 볼 발사 또는 임팩트를 측정하지 않습니다. 추적 중단 후에는 표시하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡は選択した領域の画像内の動きです。クラブ速度、ボールの打ち出し、インパクトは測定しません。追跡喪失後は描画しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轨迹是所选区域在图像中的运动，不测量杆头速度、球的发射或击球。丢失追踪后不再绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡是所選區域在影像中的運動，不測量桿頭速度、球的發射或擊球。遺失追蹤後不再繪製。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traza muestra el movimiento de la región en la imagen. No mide velocidad del palo, lanzamiento ni impacto. No se dibuja nada tras perder el seguimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O traçado mostra o movimento da região na imagem. Não mede velocidade do taco, lançamento ou impacto. Nada é desenhado após perder o rastreamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spur zeigt die Bewegung des gewählten Bildbereichs. Sie misst weder Schlägergeschwindigkeit noch Ballstart oder Treffmoment. Nach Verlust wird nichts gezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La trace montre le mouvement de la région dans l’image. Elle ne mesure ni vitesse du club, ni lancement, ni impact. Rien n’est tracé après la perte du suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traccia mostra il movimento della regione nell’immagine. Non misura velocità del bastone, lancio o impatto. Dopo la perdita del tracciamento non viene disegnato nulla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางแสดงการเคลื่อนที่ของพื้นที่ที่เลือกในภาพ ไม่ได้วัดความเร็วไม้ การปล่อยลูก หรืออิมแพกต์ และไม่วาดต่อหลังติดตามหาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường vẽ thể hiện chuyển động vùng đã chọn trong ảnh. Không đo tốc độ gậy, phóng bóng hay va chạm. Không vẽ tiếp sau khi mất dấu."
          }
        }
