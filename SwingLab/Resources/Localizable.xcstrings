          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코스에서 라운드를 시작해 스코어카드와 GPS 샷을 기록하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
