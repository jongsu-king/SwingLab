    "Aligned at clip starts. Set impact markers in both reviews for phase alignment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligned at clip starts. Set impact markers in both reviews for phase alignment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 시작점에 맞춰 정렬했습니다. 단계 정렬을 위해 두 영상에 임팩트 표시를 설정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の開始点で整列しています。フェーズで揃えるには両方にインパクトを設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按片段起点对齐。请在两段回顾中设置触球标记以对齐阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已按片段起點對齊。請在兩段檢視中設定觸球標記以對齊階段。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alineado al inicio. Marca el impacto en ambas revisiones para alinear las fases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhado pelo início. Marque o impacto nas duas revisões para alinhar as fases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Clipanfang ausgerichtet. Setze in beiden Aufnahmen Treffmarkierungen zur Phasenausrichtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligné sur le début des vidéos. Placez un repère d’impact dans chacune pour aligner les phases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allineato all’inizio dei video. Imposta l’impatto in entrambi per allineare le fasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดแนวที่ต้นคลิป ตั้งเครื่องหมายอิมแพคในทั้งสองวิดีโอเพื่อจัดแนวตามช่วง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã căn theo đầu video. Đặt mốc tiếp xúc bóng ở cả hai video để căn theo giai đoạn."
          }
        }
      }
    },
    "Aligned at impact markers. Estimated markers require review.": {
