    "Handedness changed. Analyze again to update lead and trail joints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handedness changed. Analyze again to update lead and trail joints."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주사용 손이 변경되었습니다. 다시 분석하여 리드 및 트레일 관절을 업데이트하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利き手が変更されました。リード側とトレイル側の関節を更新するには再解析してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "惯用手已更改。请重新分析以更新前侧和后侧关节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慣用手已變更。請重新分析以更新前側和後側關節。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano dominante ha cambiado. Analiza de nuevo para actualizar las articulaciones del lado adelantado y trasero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão dominante mudou. Analise novamente para atualizar as articulações do lado da frente e de trás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spielhand wurde geändert. Analysieren Sie erneut, um die führenden und nachfolgenden Gelenke zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latéralité a changé. Relancez l’analyse pour actualiser les articulations des côtés avant et arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano dominante è cambiata. Ripeti l’analisi per aggiornare le articolazioni del lato anteriore e posteriore."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนมือถนัดแล้ว วิเคราะห์อีกครั้งเพื่ออัปเดตข้อต่อด้านนำและด้านตาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay thuận đã thay đổi. Hãy phân tích lại để cập nhật các khớp phía dẫn và phía sau."
          }
        }
      }
    },
    "Hazard probabilities and safer aim points require verified course geometry and are unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazard probabilities and safer aim points require verified course geometry and are unavailable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해저드 확률과 더 안전한 조준점에는 검증된 코스 지형이 필요하며 현재 제공되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハザード確率と安全な狙い所には検証済みコース形状が必要なため、利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "障碍概率和更安全的瞄准点需要经验证的球场几何数据，目前不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "障礙機率和更安全的瞄準點需要經驗證的球場幾何資料，目前無法提供。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las probabilidades de obstáculos y objetivos más seguros requieren geometría verificada; no están disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilidades de obstáculos e alvos mais seguros exigem geometria validada e estão indisponíveis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinderniswahrscheinlichkeiten und sicherere Ziele benötigen geprüfte Platzgeometrie und sind nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilités d’obstacles et cibles plus sûres nécessitent une géométrie vérifiée et sont indisponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilità di ostacoli e mire più sicure richiedono geometrie verificate e non sono disponibili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความน่าจะเป็นของอุปสรรคและจุดเล็งที่ปลอดภัยกว่าต้องใช้รูปทรงสนามที่ตรวจสอบแล้ว จึงยังไม่มีข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác suất chướng ngại và điểm ngắm an toàn hơn cần hình học sân đã xác minh nên hiện chưa có."
          }
        }
      }
    },
