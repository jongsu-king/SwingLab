    "The ball could not be followed after impact. Keep the first metre of flight in the frame.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ball could not be followed after impact. Keep the first metre of flight in the frame."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임팩트 후 공을 추적하지 못했습니다. 비행 첫 1m가 화면에 들어오게 촬영하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インパクト後のボールを追跡できませんでした。飛び出し最初の1メートルが画面に入るように撮影してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球后无法追踪到球。请让飞行的前 1 米保持在画面内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊球後無法追蹤到球。請讓飛行的前 1 公尺保持在畫面內。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo seguir la bola tras el impacto. Mantén el primer metro de vuelo dentro del encuadre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível seguir a bola após o impacto. Mantenha o primeiro metro de voo no enquadramento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ball ließ sich nach dem Treffmoment nicht verfolgen. Halte den ersten Meter des Flugs im Bild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balle n’a pas pu être suivie après l’impact. Gardez le premier mètre de vol dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile seguire la palla dopo l’impatto. Tieni il primo metro di volo nell’inquadratura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามลูกหลังกระทบไม่ได้ ให้ช่วง 1 เมตรแรกของการบินอยู่ในเฟรม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không theo dõi được bóng sau khi chạm. Hãy giữ mét bay đầu tiên trong khung hình."
          }
        }
      }
    },
    "The ball does not come down to that landing height.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ball does not come down to that landing height."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공이 그 착지 높이까지 내려오지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボールがその着地点の高さまで下りてきません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球不会下落到该落点高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "球不會下落到該落點高度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola no baja hasta esa altura de aterrizaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola não desce até essa altura de pouso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ball sinkt nicht bis auf diese Landehöhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balle ne redescend pas jusqu’à cette hauteur d’atterrissage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla non scende fino a quell’altezza di atterraggio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลูกไม่ตกลงมาถึงความสูงจุดตกนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bóng không rơi xuống tới độ cao điểm rơi đó."
          }
        }
      }
    },
    "The ball is too blurred to measure. Record in bright light with a fast shutter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ball is too blurred to measure. Record in bright light with a fast shutter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공이 너무 번져 측정할 수 없습니다. 밝은 곳에서 빠른 셔터로 촬영하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボールのブレが大きすぎて測定できません。明るい場所で速いシャッターで撮影してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球体模糊过度，无法测量。请在明亮处用高速快门拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "球體模糊過度，無法測量。請在明亮處用高速快門拍攝。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bola está demasiado borrosa para medirla. Graba con buena luz y obturador rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola está borrada demais para medir. Grave com boa luz e obturador rápido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ball ist zu verwischt für eine Messung. Nimm bei hellem Licht mit kurzer Verschlusszeit auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balle est trop floue pour être mesurée. Filmez en pleine lumière avec un obturateur rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla è troppo mossa per essere misurata. Registra con molta luce e otturatore veloce."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลูกเบลอเกินกว่าจะวัดได้ ให้ถ่ายในที่สว่างด้วยชัตเตอร์เร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bóng bị nhòe quá nên không đo được. Hãy quay ở nơi đủ sáng với tốc độ màn trập nhanh."
          }
        }
      }
    },
    "The ball was not found at the point you tapped. Tap the centre of the ball at address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ball was not found at the point you tapped. Tap the centre of the ball at address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭한 위치에서 공을 찾지 못했습니다. 어드레스 때 공의 중앙을 탭하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップした位置でボールが見つかりませんでした。アドレス時のボールの中心をタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你轻点的位置未找到球。请轻点准备击球时球的中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你輕點的位置未找到球。請輕點準備擊球時球的中心。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la bola en el punto que tocaste. Toca el centro de la bola en el address."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bola não foi encontrada no ponto tocado. Toque no centro da bola no address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der getippten Stelle wurde kein Ball gefunden. Tippe auf die Mitte des Balls in der Ansprechposition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balle n’a pas été trouvée à l’endroit touché. Touchez le centre de la balle à l’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palla non è stata trovata nel punto toccato. Tocca il centro della palla all’address."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบลูกตรงจุดที่แตะ แตะที่กึ่งกลางลูกในท่าแอดเดรส"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bóng ở điểm bạn chạm. Hãy chạm vào tâm quả bóng ở tư thế chuẩn bị."
          }
        }
      }
    },
    "The bracket contains published averages, not a personal confidence interval.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bracket contains published averages, not a personal confidence interval."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 범위는 발표된 평균값의 범위이며 개인 신뢰구간이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲は公表平均値の幅であり、個人の信頼区間ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区间包含的是公布的平均值，不是个人置信区间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間包含的是公布的平均值，不是個人信賴區間。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo contiene promedios publicados, no un intervalo de confianza personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo contém médias publicadas, não um intervalo de confiança pessoal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spanne umfasst veröffentlichte Mittelwerte, kein persönliches Konfidenzintervall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plage contient des moyennes publiées, pas un intervalle de confiance personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervallo contiene medie pubblicate, non un intervallo di confidenza personale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงนี้ครอบคลุมค่าเฉลี่ยที่เผยแพร่ ไม่ใช่ช่วงความเชื่อมั่นส่วนบุคคล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng này chứa các số trung bình đã công bố, không phải khoảng tin cậy cá nhân."
          }
        }
      }
    },
    "The camera could not be configured. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not be configured. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 설정하지 못했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを設定できませんでした。再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配置相机。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定相機。請重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo configurar la cámara. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível configurar a câmera. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht eingerichtet werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de configurer la caméra. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile configurare la fotocamera. Riprova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่ากล้องไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
