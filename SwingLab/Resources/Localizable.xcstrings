    "Swing phases and tempo can depend on rule-based estimates. Review phase markers before comparing swings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swing phases and tempo can depend on rule-based estimates. Review phase markers before comparing swings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙 구간과 템포는 규칙 기반 추정에 의존할 수 있습니다. 스윙을 비교하기 전에 구간 표시를 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングフェーズやテンポはルールに基づく推定の場合があります。比較前にフェーズマーカーを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挥杆阶段和节奏可能依赖规则估计。比较挥杆前请检查阶段标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "揮桿階段和節奏可能依賴規則估計。比較揮桿前請檢查階段標記。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fases y el tempo pueden depender de estimaciones basadas en reglas. Revisa las fases antes de comparar swings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fases e ritmo podem depender de estimativas por regras. Revise os marcadores antes de comparar swings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwungphasen und Tempo können regelbasiert geschätzt sein. Prüfe die Phasenmarkierungen vor Vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les phases et le tempo peuvent reposer sur des estimations par règles. Vérifiez les repères avant de comparer les swings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasi e tempo possono dipendere da stime basate su regole. Verifica i marcatori prima di confrontare gli swing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟสและจังหวะอาจอิงค่าประมาณตามกฎ ตรวจจุดแบ่งเฟสก่อนเปรียบเทียบสวิง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pha và nhịp độ có thể dựa trên ước tính theo quy tắc. Kiểm tra mốc pha trước khi so sánh swing."
          }
        }
      }
    },
