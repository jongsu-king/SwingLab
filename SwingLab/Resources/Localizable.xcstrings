        }
      }
    },
    "The camera format changed. Set the ball position again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera format changed. Set the ball position again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 형식이 바뀌었어요. 공 위치를 다시 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの形式が変わりました。ボール位置をもう一度指定してください。"
