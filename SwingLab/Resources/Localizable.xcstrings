    "Live readout is unavailable: it needs the rear camera, microphone access, and launch mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live readout is unavailable: it needs the rear camera, microphone access, and launch mode."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 측정을 쓸 수 없어요. 후면 카메라, 마이크 권한, 발사 측정 모드가 필요해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム計測は使用できません。背面カメラ、マイクへのアクセス、打ち出し測定モードが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用实时读数：需要后置摄像头、麦克风权限和出球测量模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用即時讀數：需要後置相機、麥克風權限和出球測量模式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura en directo no está disponible: necesita la cámara trasera, acceso al micrófono y el modo de salida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura ao vivo não está disponível: requer a câmera traseira, acesso ao microfone e o modo de lançamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Anzeige ist nicht verfügbar: Sie braucht die Rückkamera, Mikrofonzugriff und den Abflugmodus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure en direct n'est pas disponible : elle nécessite la caméra arrière, l'accès au micro et le mode départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lettura dal vivo non è disponibile: servono la fotocamera posteriore, l'accesso al microfono e la modalità lancio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การอ่านค่าแบบเรียลไทม์ไม่ได้ ต้องใช้กล้องหลัง สิทธิ์ไมโครโฟน และโหมดวัดการออกตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đo trực tiếp: cần camera sau, quyền truy cập micrô và chế độ đo phóng."
          }
        }
      }
    },
