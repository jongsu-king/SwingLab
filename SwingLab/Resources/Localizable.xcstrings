    "A better game,\none swing at a time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A better game,\none swing at a time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙 하나하나로,\n더 나은 골프를."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一振りずつ、\nよりよいゴルフへ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次挥杆，\n都让球技更进一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次揮桿，\n都讓球技更進一步。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu juego,\nswing a swing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo melhor,\num swing de cada vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besser spielen,\nSchwung für Schwung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un meilleur jeu,\nswing après swing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco migliore,\nuno swing alla volta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นให้ดีขึ้น\nทีละสวิง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi tốt hơn,\nqua từng cú swing."
          }
        }
      }
    },
    "A closer look\nat your swing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closer look\nat your swing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스윙을\n더 자세히."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングを、\nもっと詳しく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更仔细地\n观察挥杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更仔細地\n觀察揮桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu swing,\nmás de cerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu swing,\nmais de perto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schwung,\ngenauer betrachtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre swing,\nvu de plus près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo swing,\nda vicino."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองวงสวิงของคุณ\nให้ชัดยิ่งขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn kỹ hơn\ncú swing của bạn."
          }
        }
      }
    },
    "A saved carry distance cannot establish ball speed. Values outside the published speed range are not extrapolated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved carry distance cannot establish ball speed. Values outside the published speed range are not extrapolated."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 캐리 거리로 볼 스피드를 알 수 없습니다. 발표된 속도 범위 밖의 값은 외삽하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したキャリー距離からボール初速は求められません。公表された速度範囲外への外挿は行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的飞行距离不能确定球速。不会向已公布速度范围之外外推。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的飛行距離不能確定球速。不會向已公布速度範圍之外外推。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distancia de vuelo guardada no permite determinar la velocidad de bola. No se extrapolan valores fuera del rango publicado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma distância de voo salva não determina a velocidade da bola. Valores fora da faixa publicada não são extrapolados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gespeicherte Flugweite bestimmt keine Ballgeschwindigkeit. Außerhalb des veröffentlichten Geschwindigkeitsbereichs wird nicht extrapoliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une distance de vol enregistrée ne permet pas de déterminer la vitesse de balle. Aucune extrapolation hors de la plage publiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distanza di volo salvata non determina la velocità di palla. I valori oltre l’intervallo pubblicato non vengono estrapolati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะลอยที่บันทึกไว้ไม่สามารถระบุความเร็วลูกได้ จะไม่คาดการณ์ค่านอกช่วงความเร็วที่เผยแพร่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách bay đã lưu không xác định được tốc độ bóng. Không ngoại suy ngoài khoảng tốc độ đã công bố."
          }
        }
      }
    },
