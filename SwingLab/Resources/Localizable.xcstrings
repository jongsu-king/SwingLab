    "Tap the location button for GPS, or place a ball position on the map.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the location button for GPS, or place a ball position on the map."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 버튼으로 GPS를 요청하거나 지도에 공 위치를 표시하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置ボタンでGPSを取得するか、地図上にボール位置を配置してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击定位按钮获取GPS，或在地图上设置球位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選定位按鈕取得GPS，或在地圖上設定球位。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ubicación para obtener GPS o coloca la bola en el mapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em localização para usar GPS ou marque a bola no mapa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standorttaste für GPS antippen oder Ballposition auf Karte setzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la localisation pour le GPS ou placez la balle sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la posizione per il GPS o posiziona la palla sulla mappa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มตำแหน่งเพื่อใช้ GPS หรือวางตำแหน่งลูกบนแผนที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm nút vị trí để dùng GPS hoặc đặt vị trí bóng trên bản đồ."
          }
        }
      }
    },
    "Tap the map to place the selected reference. Drag the target flag to adjust your aim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to place the selected reference. Drag the target flag to adjust your aim."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 탭하여 선택한 참고 지점을 표시하세요. 목표 깃발을 드래그해 조준점을 조정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップして参考点を配置します。目標の旗をドラッグして狙いを調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击地图放置所选参考点。拖动目标旗调整瞄准点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選地圖放置所選參考點。拖曳目標旗調整瞄準點。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el mapa para colocar la referencia. Arrastra la bandera para ajustar el objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no mapa para marcar a referência. Arraste a bandeira para ajustar a mira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte antippen, um Referenz zu setzen. Zielfahne ziehen, um die Richtung anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour placer le repère. Faites glisser le drapeau pour ajuster la visée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la mappa per inserire il riferimento. Trascina la bandiera per regolare la mira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแผนที่เพื่อวางจุดอ้างอิงที่เลือก ลากธงเป้าหมายเพื่อปรับแนวเล็ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm bản đồ để đặt điểm tham chiếu. Kéo cờ mục tiêu để chỉnh hướng ngắm."
          }
        }
      }
    },
