    "Record one swing. Review the movement. Build a practice worth repeating.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record one swing. Review the movement. Build a practice worth repeating."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙 하나를 촬영하고 움직임을 살펴보세요. 반복할 가치가 있는 연습을 만드세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度のスイングを撮影し、動きを確認。繰り返したくなる練習へ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录下一次挥杆，回顾动作，让每次练习都值得重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄下一次揮桿，檢視動作，讓每次練習都值得重複。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba un swing. Revisa el movimiento. Crea una práctica que merezca repetirse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave um swing. Reveja o movimento. Crie um treino que valha a pena repetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Schwung auf. Prüfe die Bewegung. Gestalte ein Training, das sich lohnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez un swing. Observez le mouvement. Construisez un entraînement à répéter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra uno swing. Rivedi il movimento. Crea un allenamento da ripetere."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหนึ่งวงสวิง ทบทวนการเคลื่อนไหว สร้างการฝึกที่คุ้มค่าแก่การทำซ้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay một cú swing. Xem lại chuyển động. Xây dựng bài tập đáng để lặp lại."
          }
        }
      }
    },
    "Record or import a swing. Your saved recordings and phase-based tempo will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import a swing. Your saved recordings and phase-based tempo will appear here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙을 촬영하거나 가져오세요. 저장한 영상과 구간 기준 템포가 여기에 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングを撮影または読み込みましょう。保存した動画とフェーズに基づくテンポがここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或导入挥杆。保存的录像及基于阶段的节奏将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製或匯入揮桿。儲存的錄影及依據階段計算的節奏將顯示在此處。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o importa un swing. Aquí aparecerán tus grabaciones y el tempo basado en fases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou importe um swing. Suas gravações e o ritmo baseado nas fases aparecerão aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Schwung auf oder importiere ihn. Hier erscheinen Aufnahmen und phasenbasiertes Tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez ou importez un swing. Vos vidéos et le tempo calculé à partir des phases apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o importa uno swing. Qui troverai le registrazioni e il tempo basato sulle fasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือนำเข้าสวิง วิดีโอและจังหวะที่คำนวณจากเฟสจะแสดงที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi hình hoặc nhập cú swing. Video và nhịp độ tính từ các pha sẽ xuất hiện ở đây."
          }
        }
      }
    },
    "Record or import a video to review it frame by frame and analyze body pose on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import a video to review it frame by frame and analyze body pose on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상을 촬영하거나 가져와 프레임별로 검토하고 iPhone에서 자세를 분석하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を撮影・読み込みして、iPhone上でコマ送り確認と姿勢解析ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或导入视频，在 iPhone 上逐帧回顾并分析身体姿态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製或匯入影片，在 iPhone 上逐格檢視並分析身體姿態。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o importa un vídeo para revisarlo fotograma a fotograma y analizar la postura en tu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou importe um vídeo para rever quadro a quadro e analisar a postura no iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Video auf oder importiere es, um Einzelbilder und Körperpose auf deinem iPhone zu analysieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez ou importez une vidéo pour la revoir image par image et analyser la posture sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o importa un video per rivederlo fotogramma per fotogramma e analizzare la postura su iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือนำเข้าวิดีโอเพื่อดูทีละเฟรมและวิเคราะห์ท่าทางบน iPhone"
          }
        },
        "vi": {
