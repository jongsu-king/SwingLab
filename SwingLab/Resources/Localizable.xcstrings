    "Leave unrecorded values empty. Total strokes include putts and penalties.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave unrecorded values empty. Total strokes include putts and penalties."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록하지 않은 값은 비워 두세요. 전체 타수에는 퍼트와 벌타가 포함됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未記録の値は空欄にしてください。総打数にはパットとペナルティを含みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录的值请留空。总杆数包含推杆和罚杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未記錄的值請留空。總桿數包含推桿和罰桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja vacíos los datos no registrados. El total incluye putts y penalizaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazios os valores não registrados. O total inclui putts e penalidades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erfasste Werte leer lassen. Gesamtschläge enthalten Putts und Strafschläge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez les valeurs non saisies vides. Le total inclut putts et pénalités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoti i valori non registrati. Il totale include putt e penalità."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นค่าที่ยังไม่บันทึกไว้ สโตรกรวมรวมพัตต์และโทษปรับแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống giá trị chưa ghi. Tổng số gậy gồm putt và gậy phạt."
          }
        }
      }
    },
