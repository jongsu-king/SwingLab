    "Record your swing. Know your distances. Give every shot a clear intention.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your swing. Know your distances. Give every shot a clear intention."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙을 기록하고 내 거리를 알아보세요. 모든 샷을 분명한 계획으로 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングを記録し、自分の距離を知る。一打一打に明確な狙いを。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录挥杆，了解距离，让每一杆都有明确的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄揮桿，瞭解距離，讓每一桿都有明確的目標。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu swing. Conoce tus distancias. Dale una intención clara a cada golpe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave seu swing. Conheça suas distâncias. Dê um objetivo claro a cada tacada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm deinen Schwung auf. Kenne deine Distanzen. Spiele jeden Schlag mit einem klaren Ziel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez votre swing. Connaissez vos distances. Donnez une intention claire à chaque coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo swing. Conosci le distanze. Dai un obiettivo chiaro a ogni colpo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสวิง รู้ระยะของตัวเอง ตั้งเป้าหมายให้ทุกช็อต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại cú swing. Hiểu khoảng cách của mình. Đặt mục tiêu rõ ràng cho mỗi cú đánh."
          }
        }
      }
    },
    "Record your swing. Know your distances. Plan your next shot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your swing. Know your distances. Plan your next shot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙을 기록하고, 나만의 거리를 파악하고, 다음 샷을 계획하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングを記録し、自分の飛距離を把握して、次のショットを計画しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录挥杆，了解自己的距离，规划下一杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄揮桿，掌握自己的距離，規劃下一桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu swing. Conoce tus distancias. Planifica tu próximo golpe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave seu swing. Conheça suas distâncias. Planeje sua próxima tacada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne deinen Schwung auf. Kenne deine Schlagweiten. Plane deinen nächsten Schlag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre swing. Connaissez vos distances. Préparez votre prochain coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il tuo swing. Conosci le tue distanze. Pianifica il prossimo colpo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกวงสวิง รู้ระยะของคุณ วางแผนช็อตถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại cú swing. Nắm rõ khoảng cách. Lên kế hoạch cho cú đánh tiếp theo."
          }
        }
      }
    },
