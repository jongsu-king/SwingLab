    "Some data could not be removed. Try again before leaving this screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some data could not be removed. Try again before leaving this screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 데이터를 삭제하지 못했습니다. 이 화면을 나가기 전에 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のデータを削除できませんでした。この画面を閉じる前に再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据未能删除。离开此页面前请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資料未能刪除。離開此頁面前請再試一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar algunos datos. Inténtalo de nuevo antes de salir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns dados não puderam ser removidos. Tente novamente antes de sair desta tela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Daten konnten nicht entfernt werden. Versuche es erneut, bevor du diese Ansicht verlässt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données n’ont pas pu être supprimées. Réessayez avant de quitter cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni dati non sono stati rimossi. Riprova prima di lasciare questa schermata."
          }
