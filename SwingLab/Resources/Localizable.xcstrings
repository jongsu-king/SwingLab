          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as alterações. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gespeichert werden. Erneut versuchen."
          }
        },
