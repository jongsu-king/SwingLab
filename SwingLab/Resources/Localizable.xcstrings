          }
        }
      }
    },
    "The distance between two recorded positions is ground displacement. It includes location uncertainty and is not measured airborne carry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distance between two recorded positions is ground displacement. It includes location uncertainty and is not measured airborne carry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 두 위치 사이 거리는 지상 변위입니다. 위치 오차가 포함되며 공중 캐리 측정값이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した2地点間の距離は地上の移動距離です。位置の誤差を含み、空中のキャリー測定ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个记录位置之间的距离是地面位移，包含定位误差，并非测得的空中飞行距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個記錄位置之間的距離是地面位移，包含定位誤差，並非測得的空中飛行距離。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia entre dos posiciones es desplazamiento terrestre. Incluye incertidumbre de ubicación y no mide la distancia de vuelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância entre duas posições é deslocamento no solo. Inclui incerteza de localização e não mede a distância aérea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abstand zweier gespeicherter Positionen ist Bodenverschiebung. Er enthält Standortunsicherheit und ist kein gemessener Carry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance entre deux positions est un déplacement au sol. Elle inclut l’incertitude de localisation et ne mesure pas la portée en vol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza tra due posizioni è uno spostamento al suolo. Include l’incertezza della posizione e non misura la distanza in volo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะระหว่างตำแหน่งสองจุดคือระยะบนพื้น มีความคลาดเคลื่อนตำแหน่งและไม่ใช่ระยะลอยที่วัดได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách giữa hai vị trí là độ dịch chuyển trên mặt đất, có sai số định vị và không phải khoảng cách bay đo được."
          }
        }
      }
    },
    "The original video is no longer available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original video is no longer available."
