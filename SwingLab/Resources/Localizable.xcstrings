    "Keep your full body and club in view.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your full body and club in view."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 전체와 클럽이 화면에 들어오게 하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身とクラブが画面に収まるようにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让全身和球杆保持在画面内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓全身和球桿保持在畫面內。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén todo el cuerpo y el palo dentro del encuadre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o corpo inteiro e o taco no enquadramento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den ganzen Körper und den Schläger im Bild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez tout le corps et le club dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra tutto il corpo e il bastone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เห็นทั้งตัวและไม้กอล์ฟในภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ toàn thân và gậy trong khung hình."
          }
        }
      }
    },
    "Keep your whole body in view, place the iPhone safely, and record from face-on or down-the-line. Good light helps pose analysis.": {
      "extractionState": "manual",
