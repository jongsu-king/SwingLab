    "The camera could not be configured. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not be configured. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 설정하지 못했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを設定できませんでした。再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配置相机。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定相機。請重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo configurar la cámara. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível configurar a câmera. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht eingerichtet werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de configurer la caméra. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile configurare la fotocamera. Riprova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่ากล้องไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cấu hình camera. Vui lòng thử lại."
          }
        }
      }
    },
    "The camera stopped. Close the camera and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera stopped. Close the camera and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 중지되었습니다. 카메라를 닫고 다시 시도하세요."
