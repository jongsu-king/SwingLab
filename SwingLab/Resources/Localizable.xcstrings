    "The second recording has a longer backswing. Repeat the same drill and compare your next recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second recording has a longer backswing. Repeat the same drill and compare your next recording."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 영상의 백스윙 시간이 더 깁니다. 같은 드릴을 반복하고 다음 영상과 비교하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つ目の動画はバックスイング時間が長くなっています。同じドリルを繰り返して次の動画と比較しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二段录像的上杆时间更长。请重复相同练习，并与下次录像比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第二段錄影的上桿時間更長。請重複相同練習，並與下次錄影比較。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La segunda grabación tiene una subida más larga. Repite el ejercicio y compara la próxima grabación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A segunda gravação tem uma subida mais longa. Repita o exercício e compare a próxima gravação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zweite Aufnahme hat einen längeren Rückschwung. Wiederhole die Übung und vergleiche die nächste Aufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuxième vidéo présente une montée plus longue. Répétez l’exercice et comparez la prochaine vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il secondo video ha un backswing più lungo. Ripeti l’esercizio e confronta la prossima registrazione."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอที่สองมีแบ็กสวิงนานกว่า ทำแบบฝึกเดิมซ้ำแล้วเทียบกับวิดีโอถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video thứ hai có backswing dài hơn. Lặp lại cùng bài tập và so sánh với video tiếp theo."
          }
        }
      }
    },
