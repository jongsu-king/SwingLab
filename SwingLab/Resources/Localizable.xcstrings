    "Keep your full body and club in view.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your full body and club in view."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 전체와 클럽이 화면에 들어오게 하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身とクラブが画面に収まるようにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让全身和球杆保持在画面内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓全身和球桿保持在畫面內。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén todo el cuerpo y el palo dentro del encuadre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o corpo inteiro e o taco no enquadramento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den ganzen Körper und den Schläger im Bild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez tout le corps et le club dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra tutto il corpo e il bastone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เห็นทั้งตัวและไม้กอล์ฟในภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ toàn thân và gậy trong khung hình."
          }
        }
      }
    },
    "Keep your whole body in view, place the iPhone safely, and record from face-on or down-the-line. Good light helps pose analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your whole body in view, place the iPhone safely, and record from face-on or down-the-line. Good light helps pose analysis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 전체가 보이도록 iPhone을 안전하게 놓고 정면 또는 타깃 라인 뒤에서 촬영하세요. 밝은 환경이 자세 분석에 도움이 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身が映るようiPhoneを安全に置き、正面または飛球線後方から撮影しましょう。明るい環境は姿勢解析に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保全身入镜，将 iPhone 安全放置，从正面或目标线后方录制。良好光线有助于姿态分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保全身入鏡，將 iPhone 安全放置，從正面或目標線後方錄製。良好光線有助於姿態分析。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuadra todo el cuerpo, coloca el iPhone con seguridad y graba de frente o desde la línea de tiro. Una buena luz ayuda al análisis de postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquadre o corpo inteiro, posicione o iPhone com segurança e grave de frente ou pela linha do alvo. Boa luz ajuda a análise de postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den ganzen Körper im Bild, stelle das iPhone sicher auf und filme von vorn oder entlang der Ziellinie. Gutes Licht unterstützt die Posenanalyse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrez le corps entier, placez l’iPhone en sécurité et filmez de face ou dans l’axe du jeu. Une bonne lumière aide l’analyse de posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra tutto il corpo, posiziona iPhone in sicurezza e riprendi frontalmente o lungo la linea di tiro. Una buona luce aiuta l’analisi della postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เห็นทั้งตัว วาง iPhone อย่างปลอดภัย แล้วถ่ายจากด้านหน้าหรือตามแนวเป้าหมาย แสงที่ดีช่วยวิเคราะห์ท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để toàn thân trong khung hình, đặt iPhone an toàn và quay chính diện hoặc dọc đường mục tiêu. Ánh sáng tốt giúp phân tích tư thế."
          }
        }
      }
    },
