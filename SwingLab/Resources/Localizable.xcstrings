    "Map import failed. Your saved areas are still available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map import failed. Your saved areas are still available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 가져오기에 실패했습니다. 저장된 영역은 계속 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を読み込めませんでした。保存済みのエリアは引き続き利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图导入失败。已保存区域仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖匯入失敗。已儲存區域仍可使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo importar el mapa. Tus zonas guardadas siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao importar o mapa. Suas áreas salvas continuam disponíveis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenimport fehlgeschlagen. Gespeicherte Flächen bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’importation. Vos zones enregistrées restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione non riuscita. Le aree salvate restano disponibili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าแผนที่ไม่สำเร็จ พื้นที่ที่บันทึกยังใช้งานได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập bản đồ thất bại. Khu vực đã lưu vẫn khả dụng."
          }
        }
      }
    },
