    "Inner region: 50%. Dashed outer region: 80%. Conditional on your entered club profile; not a calibrated guarantee.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inner region: 50%. Dashed outer region: 80%. Conditional on your entered club profile; not a calibrated guarantee."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안쪽 영역: 50%. 바깥 점선 영역: 80%. 입력한 클럽 정보에 따른 조건부 확률이며 검증된 보장이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内側50%、外側破線80%。入力したクラブ情報を条件とした確率で、校正済みの保証ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内侧区域50%，外侧虚线区域80%。概率以输入的球杆资料为条件，并非经校准的保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內側區域50%，外側虛線區域80%。機率以輸入的球桿資料為條件，並非經校準的保證。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Región interior: 50 %. Exterior discontinua: 80 %. Condicionado al perfil introducido; no es una garantía calibrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Região interna: 50%. Externa tracejada: 80%. Condicional ao perfil informado; não é garantia calibrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innen 50 %, gestrichelt außen 80 %. Bedingt auf eingegebene Schlägerdaten; keine kalibrierte Garantie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Région intérieure : 50 %. Extérieure en pointillés : 80 %. Conditionnel au profil saisi, sans garantie étalonnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regione interna: 50%. Esterna tratteggiata: 80%. Condizionate al profilo inserito, non garanzie calibrate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริเวณด้านใน 50% เส้นประด้านนอก 80% ขึ้นกับข้อมูลไม้ที่กรอก ไม่ใช่การรับประกันที่สอบเทียบแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng trong: 50%. Vùng nét đứt ngoài: 80%. Có điều kiện theo hồ sơ gậy đã nhập, không phải bảo đảm đã hiệu chuẩn."
          }
        }
      }
    },
