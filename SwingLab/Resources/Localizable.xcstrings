          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供障碍区域，风险不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供障礙區域，風險不可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesgo no disponible: faltan zonas de obstáculos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Risco indisponível: nenhuma área de obstáculo informada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiko nicht verfügbar: keine Hindernisflächen erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Risque indisponible : aucune zone d’obstacle fournie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rischio non disponibile: nessuna area di ostacolo inserita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบความเสี่ยง เนื่องจากไม่มีพื้นที่อุปสรรค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa rõ rủi ro vì chưa có vùng chướng ngại."
          }
        }
      }
    },
    "Hazard risk uses supplied polygons in Caddie. Missing boundaries remain unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazard risk uses supplied polygons in Caddie. Missing boundaries remain unavailable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐디는 입력된 다각형으로 해저드 위험을 계산합니다. 경계가 없으면 알 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャディは入力された多角形でリスクを計算します。境界がない場所は不明のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球童用已提供多边形计算风险。缺失边界仍不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "球僮用已提供多邊形計算風險。缺失邊界仍不可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El caddie calcula riesgos con los polígonos aportados. Los límites ausentes siguen sin estar disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caddie usa polígonos informados para calcular riscos. Limites ausentes continuam indisponíveis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Caddie berechnet Risiken anhand erfasster Polygone. Fehlende Grenzen bleiben unbekannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le caddie utilise les polygones fournis pour les risques. Les limites manquantes restent indisponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caddie usa i poligoni inseriti per i rischi. I confini mancanti restano sconosciuti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคดดี้ใช้รูปหลายเหลี่ยมที่ป้อนคำนวณความเสี่ยง ขอบเขตที่ขาดยังไม่พร้อมใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddie dùng đa giác đã nhập để tính rủi ro. Ranh giới thiếu vẫn chưa rõ."
          }
        }
      }
    },
