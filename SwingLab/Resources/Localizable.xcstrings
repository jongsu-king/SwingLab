    "The record was removed, but its video could not be erased. Use Delete All Local Data in Settings to retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record was removed, but its video could not be erased. Use Delete All Local Data in Settings to retry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 삭제했지만 영상 파일은 지우지 못했습니다. 설정의 모든 로컬 데이터 삭제로 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録は削除しましたが動画を消去できませんでした。設定の「すべてのローカルデータを削除」で再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已删除，但视频文件未能清除。请在设置中使用“删除全部本地数据”重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄已刪除，但影片檔案未能清除。請在設定中使用「刪除全部本機資料」重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el registro, pero no el vídeo. Reintenta con Eliminar todos los datos locales en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro foi excluído, mas o vídeo não. Tente Excluir todos os dados locais nos Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wurde gelöscht, das Video jedoch nicht. Nutze „Alle lokalen Daten löschen“ in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée a été supprimée, mais pas la vidéo. Réessayez avec Supprimer toutes les données locales dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce è stata rimossa, ma non il video. Riprova con Elimina tutti i dati locali nelle Impostazioni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการแล้วแต่ลบไฟล์วิดีโอไม่ได้ ใช้ลบข้อมูลในเครื่องทั้งหมดในการตั้งค่าเพื่อลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa bản ghi nhưng chưa xóa được tệp video. Dùng Xóa toàn bộ dữ liệu cục bộ trong Cài đặt để thử lại."
          }
        }
      }
    },
    "The recording could not be deleted. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be deleted. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 기록을 삭제하지 못했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
