    "Launch measurement needs a video recorded at 200 fps or more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch measurement needs a video recorded at 200 fps or more."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발사 측정에는 200fps 이상으로 촬영한 영상이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打ち出しの測定には200fps以上で撮影した動画が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量出球需要以 200 fps 或更高帧率录制的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測量出球需要以 200 fps 或更高影格率錄製的影片。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición de la salida necesita un video grabado a 200 fps o más."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição do lançamento precisa de um vídeo gravado a 200 fps ou mais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abflugmessung braucht ein Video mit mindestens 200 fps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
