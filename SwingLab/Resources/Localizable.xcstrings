          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes finalizar una vuelta incompleta. Los hoyos sin resultado quedan vacíos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode encerrar uma rodada incompleta. Buracos sem pontuação ficam vazios."
