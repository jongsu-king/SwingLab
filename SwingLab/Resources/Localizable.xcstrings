    "Strokes include putts and penalties. GPS shot logs do not automatically change your score.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strokes include putts and penalties. GPS shot logs do not automatically change your score."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타수에는 퍼트와 벌타가 포함됩니다. GPS 샷 기록은 점수를 자동 변경하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打数にはパットとペナルティを含みます。GPSショット履歴でスコアは自動変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杆数包含推杆和罚杆。GPS击球记录不会自动更改分数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桿數包含推桿和罰桿。GPS擊球記錄不會自動更改分數。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los golpes incluyen putts y penalizaciones. El registro GPS no cambia el resultado automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tacadas incluem putts e penalidades. O registro GPS não altera o placar automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläge enthalten Putts und Strafschläge. GPS-Aufzeichnungen ändern den Score nicht automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups incluent putts et pénalités. Le journal GPS ne modifie pas automatiquement le score."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colpi includono putt e penalità. Il registro GPS non cambia il punteggio automaticamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สโตรกรวมพัตต์และโทษปรับแล้ว บันทึก GPS ไม่เปลี่ยนสกอร์อัตโนมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số gậy gồm putt và gậy phạt. Nhật ký GPS không tự thay đổi điểm."
          }
        }
      }
    },
