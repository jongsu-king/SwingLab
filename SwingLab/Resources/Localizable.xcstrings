    "Pars start empty unless you entered them before. Add scores, putts and penalties in the scorecard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pars start empty unless you entered them before. Add scores, putts and penalties in the scorecard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 입력하지 않은 파는 비어 있습니다. 스코어카드에서 타수·퍼트·벌타를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーは以前入力したもの以外は空欄です。スコアカードで打数・パット・ペナルティを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准杆默认为空，除非曾手动输入。请在记分卡中填写杆数、推杆和罚杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準桿預設為空，除非曾手動輸入。請在計分卡中填寫桿數、推桿和罰桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El par queda vacío si no se introdujo antes. Añade golpes, putts y penalizaciones en la tarjeta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O par fica vazio se não foi informado antes. Adicione tacadas, putts e penalidades no cartão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Par bleibt ohne frühere Eingabe leer. Schläge, Putts und Strafschläge in der Scorekarte eintragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pars restent vides s’ils n’ont pas été saisis. Ajoutez coups, putts et pénalités sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il par resta vuoto se non già inserito. Aggiungi colpi, putt e penalità nel segnapunti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาร์จะว่างหากยังไม่เคยกรอก เพิ่มสโตรก พัตต์ และโทษปรับในสกอร์การ์ด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Par để trống nếu chưa từng nhập. Thêm số gậy, putt và gậy phạt trong bảng điểm."
          }
        }
      }
    },
