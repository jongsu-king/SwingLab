          }
        }
      }
    },
    "Record or import two swings to compare their movement and timing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import two swings to compare their movement and timing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 스윙을 촬영하거나 가져와 움직임과 타이밍을 비교하세요."
          }
        },
        "ja": {
          "stringUnit": {
