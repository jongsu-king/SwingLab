    "Save a round and fill in your scorecard. Scoring, putts, and penalties will come from your own entries.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a round and fill in your scorecard. Scoring, putts, and penalties will come from your own entries."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라운드를 저장하고 스코어카드를 작성하세요. 스코어, 퍼트, 벌타는 직접 입력한 기록을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラウンドを保存し、スコアカードを記入しましょう。スコア、パット、ペナルティーは自分の入力を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一轮并填写记分卡。杆数、推杆和罚杆均来自你的输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存回合並填寫計分卡。桿數、推桿和罰桿均來自你的輸入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una ronda y completa la tarjeta. Golpes, putts y penalizaciones provienen de tus datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma rodada e preencha o cartão. Tacadas, putts e penalidades vêm dos seus registros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Runde und fülle die Scorekarte aus. Schläge, Putts und Strafschläge stammen aus deinen Eingaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une partie et remplissez la carte. Scores, putts et pénalités viennent de vos saisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un giro e compila lo score. Colpi, putt e penalità derivano dalle tue registrazioni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรอบและกรอกสกอร์การ์ด คะแนน พัตต์ และโทษมาจากข้อมูลที่คุณกรอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu vòng chơi và điền bảng điểm. Điểm, putt và gậy phạt lấy từ dữ liệu bạn nhập."
          }
        }
      }
    },
