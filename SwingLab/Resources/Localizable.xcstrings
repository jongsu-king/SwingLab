    "No account is required. You control the recordings, clubs, and rounds saved on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. You control the recordings, clubs, and rounds saved on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요하지 않습니다. 이 iPhone에 저장된 영상, 클럽, 라운드를 직접 관리합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。このiPhoneの動画、クラブ、ラウンドを自分で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户。你可以管理保存在此 iPhone 上的录像、球杆和轮次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需帳號。你可以管理儲存在此 iPhone 上的錄影、球桿和回合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas cuenta. Controlas las grabaciones, palos y rondas guardados en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta é necessária. Você controla as gravações, os tacos e as rodadas salvos neste iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto erforderlich. Du verwaltest Aufnahmen, Schläger und Runden auf diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte requis. Vous contrôlez les vidéos, clubs et parties enregistrés sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve un account. Gestisci registrazioni, bastoni e giri salvati su questo iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี คุณควบคุมวิดีโอ ไม้กอล์ฟ และรอบที่เก็บบน iPhone นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Bạn quản lý video, gậy và vòng chơi lưu trên iPhone này."
          }
        }
      }
    },
    "No places found. Try the course name with its city.": {
