    "Ball position: user-entered. Shot recording always uses a fresh GPS fix.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ball position: user-entered. Shot recording always uses a fresh GPS fix."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공 위치는 직접 입력했습니다. 샷 기록에는 항상 최신 GPS 위치를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボール位置は手動入力です。ショット記録には常に新しいGPS位置を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "球位由用户输入。记录击球时始终使用最新GPS定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "球位由使用者輸入。記錄擊球時一律使用最新GPS定位。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posición manual. Los golpes se registran siempre con una posición GPS reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posição manual. As tacadas sempre usam uma localização GPS recente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballposition manuell. Schlagaufzeichnungen verwenden stets eine aktuelle GPS-Position."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position saisie manuellement. Les coups utilisent toujours une position GPS récente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione manuale. I colpi usano sempre una posizione GPS recente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งลูกระบุโดยผู้ใช้ การบันทึกช็อตใช้ตำแหน่ง GPS ล่าสุดเสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí bóng nhập thủ công. Cú đánh luôn được ghi bằng vị trí GPS mới."
          }
        }
      }
    },
