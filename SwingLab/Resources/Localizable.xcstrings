            "state": "translated",
            "value": "Antes do próximo tee"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem nächsten Abschlag"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant le prochain départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima del prossimo tee"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนออกรอบครั้งถัดไป"
          }
