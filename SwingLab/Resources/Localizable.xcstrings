    "Camera interrupted. Recording will resume only when you start it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera interrupted. Recording will resume only when you start it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 중단되었습니다. 직접 다시 시작해야 촬영됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが中断されました。録画は手動で再開してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机已中断。需手动重新开始录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機已中斷。需手動重新開始錄製。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara interrumpida. La grabación solo se reanudará cuando la inicies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera interrompida. A gravação só continuará quando você a iniciar novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera unterbrochen. Die Aufnahme startet erst, wenn du sie erneut beginnst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra interrompue. Relancez manuellement l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera interrotta. La registrazione riprenderà solo quando la riavvierai."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องถูกขัดจังหวะ การบันทึกจะเริ่มเมื่อคุณสั่งอีกครั้งเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera bị gián đoạn. Chỉ tiếp tục quay khi bạn khởi động lại."
          }
        }
      }
    },
