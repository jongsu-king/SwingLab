          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 전체가 보이도록 iPhone을 안전하게 놓고 정면 또는 타깃 라인 뒤에서 촬영하세요. 밝은 환경이 자세 분석에 도움이 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身が映るようiPhoneを安全に置き、正面または飛球線後方から撮影しましょう。明るい環境は姿勢解析に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保全身入镜，将 iPhone 安全放置，从正面或目标线后方录制。良好光线有助于姿态分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保全身入鏡，將 iPhone 安全放置，從正面或目標線後方錄製。良好光線有助於姿態分析。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuadra todo el cuerpo, coloca el iPhone con seguridad y graba de frente o desde la línea de tiro. Una buena luz ayuda al análisis de postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquadre o corpo inteiro, posicione o iPhone com segurança e grave de frente ou pela linha do alvo. Boa luz ajuda a análise de postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den ganzen Körper im Bild, stelle das iPhone sicher auf und filme von vorn oder entlang der Ziellinie. Gutes Licht unterstützt die Posenanalyse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrez le corps entier, placez l’iPhone en sécurité et filmez de face ou dans l’axe du jeu. Une bonne lumière aide l’analyse de posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra tutto il corpo, posiziona iPhone in sicurezza e riprendi frontalmente o lungo la linea di tiro. Una buona luce aiuta l’analisi della postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เห็นทั้งตัว วาง iPhone อย่างปลอดภัย แล้วถ่ายจากด้านหน้าหรือตามแนวเป้าหมาย แสงที่ดีช่วยวิเคราะห์ท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để toàn thân trong khung hình, đặt iPhone an toàn và quay chính diện hoặc dọc đường mục tiêu. Ánh sáng tốt giúp phân tích tư thế."
          }
        }
      }
    },
    "Know the spaces between clubs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know the spaces between clubs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클럽 간 거리 차이를 알아보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラブ間の距離差を知る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解球杆之间的距离差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瞭解球桿之間的距離差。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce las diferencias entre palos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça os intervalos entre tacos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenne die Abstände deiner Schläger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez les écarts entre vos clubs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosci gli intervalli tra i bastoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้ช่วงระยะระหว่างไม้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu chênh lệch khoảng cách giữa các gậy."
          }
        }
      }
    },
    "Landing regions use the club averages and variability you enter. They are statistical predictions and are only as reliable as those inputs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing regions use the club averages and variability you enter. They are statistical predictions and are only as reliable as those inputs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지 영역은 입력한 클럽 평균과 변동성을 사용합니다. 통계적 예측이며 신뢰도는 입력 정보에 달려 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地区域は入力したクラブの平均値とばらつきを使います。統計的な予測であり、信頼性は入力情報に依存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落地区域使用你输入的球杆平均值与变异程度，属于统计预测，其可靠性取决于输入数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落地區域使用你輸入的球桿平均值與變異程度，屬於統計預測，其可靠性取決於輸入資料。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas de caída usan las medias y variabilidad que introduces. Son predicciones estadísticas cuya fiabilidad depende de esos datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regiões de queda usam médias e variabilidade informadas. São previsões estatísticas cuja confiabilidade depende desses dados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landezonen nutzen eingegebene Schlägermittelwerte und Streuungen. Ihre statistischen Vorhersagen sind nur so zuverlässig wie die Eingaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones de retombée utilisent vos moyennes et variabilités. Ces prédictions statistiques dépendent de la fiabilité des données saisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zone di atterraggio usano medie e variabilità inserite. Sono previsioni statistiche affidabili solo quanto i dati forniti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ตกใช้ค่าเฉลี่ยและความแปรปรวนที่คุณกรอก เป็นการคาดการณ์ทางสถิติที่น่าเชื่อถือเท่าข้อมูลนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng tiếp đất dùng giá trị trung bình và độ biến thiên bạn nhập. Độ tin cậy của dự đoán thống kê phụ thuộc vào dữ liệu đó."
          }
        }
      }
    },
