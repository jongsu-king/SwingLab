    "Videos and pose analysis stay on your iPhone. Camera recording is silent. Imported videos keep their original audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos and pose analysis stay on your iPhone. Camera recording is silent. Imported videos keep their original audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상과 자세 분석은 iPhone에 저장됩니다. 카메라는 무음으로 촬영하며 가져온 영상의 원래 오디오는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画と姿勢解析はiPhone内に保存されます。撮影は無音で、読み込んだ動画の音声は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频和姿态分析保存在你的 iPhone 上。相机录制无声，导入视频保留原始音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片和姿態分析儲存在你的 iPhone 上。相機錄製無聲，匯入影片保留原始音訊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos y análisis quedan en tu iPhone. La cámara graba sin sonido. Los vídeos importados conservan su audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos e análises ficam no iPhone. A câmera grava sem som. Vídeos importados mantêm o áudio original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos und Poseanalysen bleiben auf deinem iPhone. Kameraaufnahmen sind stumm. Importierte Videos behalten ihren Ton."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos et analyses restent sur votre iPhone. La caméra filme sans son. L’audio des vidéos importées est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video e analisi restano su iPhone. La fotocamera registra senza audio. I video importati mantengono l’audio originale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอและการวิเคราะห์ท่าทางอยู่บน iPhone การบันทึกกล้องไม่มีเสียง วิดีโอนำเข้าคงเสียงเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video và phân tích tư thế lưu trên iPhone. Camera quay không âm thanh. Video nhập giữ nguyên âm thanh gốc."
          }
        }
      }
    },
    "Videos, sound, and pose analysis stay on your iPhone. Imported videos keep their original audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, sound, and pose analysis stay on your iPhone. Imported videos keep their original audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상, 소리, 자세 분석은 모두 iPhone 안에만 저장됩니다. 가져온 영상은 원래 오디오를 유지합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画、音声、姿勢分析はすべてiPhone内に保存されます。読み込んだ動画は元の音声を保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频、声音和姿态分析都只保存在你的 iPhone 上。导入的视频保留原始音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片、聲音和姿態分析都只保存在你的 iPhone 上。匯入的影片保留原始音訊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los videos, el sonido y el análisis de postura se quedan en tu iPhone. Los videos importados conservan su audio original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos, som e análise de postura ficam no seu iPhone. Vídeos importados mantêm o áudio original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, Ton und Haltungsanalyse bleiben auf deinem iPhone. Importierte Videos behalten ihren Originalton."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos, le son et l’analyse de posture restent sur votre iPhone. Les vidéos importées conservent leur audio d’origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, audio e analisi della postura restano sul tuo iPhone. I video importati mantengono l’audio originale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอ เสียง และการวิเคราะห์ท่าทางจะอยู่ใน iPhone ของคุณเท่านั้น วิดีโอที่นำเข้าจะคงเสียงเดิมไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, âm thanh và phân tích tư thế đều nằm trên iPhone của bạn. Video được nhập giữ nguyên âm thanh gốc."
          }
        }
      }
    },
