    "User-entered averages. Distances are not camera or GPS measurements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-entered averages. Distances are not camera or GPS measurements."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 입력한 평균값입니다. 카메라나 GPS로 측정한 거리가 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー入力の平均値です。カメラやGPSで測った距離ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入的平均值，并非相机或 GPS 测量的距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者輸入的平均值，並非相機或 GPS 測量的距離。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medias introducidas por el usuario. No son distancias medidas por cámara o GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Médias informadas pelo usuário. Não são distâncias medidas por câmera ou GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Nutzer eingegebene Mittelwerte. Keine Kamera- oder GPS-Messungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyennes saisies par l’utilisateur. Distances non mesurées par caméra ou GPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Medie inserite dall’utente. Non sono distanze misurate da fotocamera o GPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเฉลี่ยที่ผู้ใช้กรอก ไม่ใช่ระยะที่วัดด้วยกล้องหรือ GPS"
