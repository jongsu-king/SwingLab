    "Complete or delete the pending shot before finishing the round.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete or delete the pending shot before finishing the round."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라운드를 끝내기 전에 대기 중인 샷을 완료하거나 삭제하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラウンドを終了する前に、未完了のショットを完了または削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束球局前，请完成或删除待记录的击球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束球局前，請完成或刪除待記錄的擊球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa o elimina el golpe pendiente antes de finalizar la vuelta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua ou exclua a tacada pendente antes de encerrar a rodada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehenden Schlag vor Rundenende abschließen oder löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez ou supprimez le coup en attente avant de terminer la partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa o elimina il colpo in sospeso prima di terminare il giro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
