    "Consistency uses at least five available values from the same club and camera angle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency uses at least five available values from the same club and camera angle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관성은 같은 클럽과 촬영 각도에서 얻은 사용 가능한 측정값이 최소 5개일 때 계산합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一貫性は、同じクラブと撮影アングルで得られた有効な測定値が5件以上ある場合に計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一致性计算至少需要同一球杆和拍摄角度下的五个有效测量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一致性計算至少需要同一球桿和拍攝角度下的五個有效測量值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consistencia se calcula con al menos cinco valores disponibles del mismo palo y ángulo de cámara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A consistência usa pelo menos cinco valores disponíveis do mesmo taco e ângulo de câmera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konstanz wird aus mindestens fünf verfügbaren Werten mit demselben Schläger und Kamerawinkel berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La régularité utilise au moins cinq valeurs disponibles avec le même club et le même angle de caméra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regolarità usa almeno cinque valori disponibili con lo stesso bastone e la stessa angolazione della fotocamera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคำนวณความสม่ำเสมอใช้ค่าที่มีอย่างน้อยห้าค่าจากไม้และมุมกล้องเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ ổn định được tính từ ít nhất năm giá trị có sẵn của cùng gậy và góc quay."
          }
        }
      }
    },
    "Correlation must be greater than −1 and less than 1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correlation must be greater than −1 and less than 1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상관계수는 −1보다 크고 1보다 작아야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相関係数は−1より大きく、1より小さくしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关系数必须大于 −1 且小于 1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關係數必須大於 −1 且小於 1。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La correlación debe ser mayor que −1 y menor que 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A correlação deve ser maior que −1 e menor que 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Korrelation muss größer als −1 und kleiner als 1 sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrélation doit être supérieure à −1 et inférieure à 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La correlazione deve essere maggiore di −1 e minore di 1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สหสัมพันธ์ต้องมากกว่า −1 และน้อยกว่า 1"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ số tương quan phải lớn hơn −1 và nhỏ hơn 1."
          }
        }
      }
    },
