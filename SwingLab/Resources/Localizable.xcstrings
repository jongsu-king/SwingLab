    "Aligned at clip starts. Set impact markers in both reviews for phase alignment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligned at clip starts. Set impact markers in both reviews for phase alignment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 시작점에 맞춰 정렬했습니다. 단계 정렬을 위해 두 영상에 임팩트 표시를 설정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の開始点で整列しています。フェーズで揃えるには両方にインパクトを設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按片段起点对齐。请在两段回顾中设置触球标记以对齐阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已按片段起點對齊。請在兩段檢視中設定觸球標記以對齊階段。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alineado al inicio. Marca el impacto en ambas revisiones para alinear las fases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhado pelo início. Marque o impacto nas duas revisões para alinhar as fases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Clipanfang ausgerichtet. Setze in beiden Aufnahmen Treffmarkierungen zur Phasenausrichtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligné sur le début des vidéos. Placez un repère d’impact dans chacune pour aligner les phases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allineato all’inizio dei video. Imposta l’impatto in entrambi per allineare le fasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดแนวที่ต้นคลิป ตั้งเครื่องหมายอิมแพคในทั้งสองวิดีโอเพื่อจัดแนวตามช่วง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã căn theo đầu video. Đặt mốc tiếp xúc bóng ở cả hai video để căn theo giai đoạn."
          }
        }
      }
    },
    "Aligned at impact markers. Estimated markers require review.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligned at impact markers. Estimated markers require review."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임팩트 표시에 맞춰 정렬했습니다. 추정 표시는 검토가 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インパクトマーカーで整列しています。推定マーカーは確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按触球标记对齐。估算标记需要检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已按觸球標記對齊。估算標記需要檢查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alineado en el impacto. Revisa los marcadores estimados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhado no impacto. Revise os marcadores estimados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Treffmarkierungen ausgerichtet. Geschätzte Markierungen müssen geprüft werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligné sur les repères d’impact. Vérifiez les repères estimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allineato ai marcatori d’impatto. Verifica i marcatori stimati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดแนวที่เครื่องหมายอิมแพค ต้องตรวจสอบเครื่องหมายประมาณค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã căn theo mốc tiếp xúc bóng. Cần kiểm tra các mốc ước tính."
          }
        }
      }
    },
