    "Set the ball position, then hit. The readout appears about a second after impact.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the ball position, then hit. The readout appears about a second after impact."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공 위치를 지정한 뒤 치세요. 임팩트 후 1초 정도면 값이 나와요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボール位置を指定してから打ってください。インパクトの約1秒後に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先设定球的位置再击球。击球后约一秒显示读数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先設定球的位置再擊球。擊球後約一秒顯示讀數。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la posición de la bola y golpea. La lectura aparece un segundo después del impacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a posição da bola e dê a tacada. A leitura aparece cerca de um segundo após o impacto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballposition festlegen, dann schlagen. Die Werte erscheinen etwa eine Sekunde nach dem Treffmoment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez la balle, puis frappez. La mesure s'affiche environ une seconde après l'impact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la posizione della palla, poi colpisci. La lettura compare circa un secondo dopo l'impatto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดตำแหน่งลูกแล้วตี ค่าจะแสดงประมาณหนึ่งวินาทีหลังอิมแพ็ค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt vị trí bóng rồi đánh. Kết quả hiện khoảng một giây sau khi chạm bóng."
          }
        }
      }
    },
