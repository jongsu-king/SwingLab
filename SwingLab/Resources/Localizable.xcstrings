          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta %1$@ a la izquierda del objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire %1$@ à esquerda do alvo."
          }
        },
        "de": {
