    "Imported areas are community mapping, not surveyed boundaries. Saved areas work offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported areas are community mapping, not surveyed boundaries. Saved areas work offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 영역은 커뮤니티 지도이며 측량된 경계가 아닙니다. 저장한 영역은 오프라인에서도 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだエリアは共同編集の地図であり、測量済みの境界ではありません。保存済みのエリアはオフラインで使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入区域来自社区地图，并非测量边界。已保存区域可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入區域來自社群地圖，並非測量邊界。已儲存區域可離線使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas importadas proceden de mapas comunitarios, no de límites topográficos. Las zonas guardadas funcionan sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As áreas importadas vêm de mapas comunitários, não de limites topográficos. As áreas salvas funcionam offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Flächen stammen aus Gemeinschaftskarten, nicht aus Vermessungen. Gespeicherte Flächen funktionieren offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones importées proviennent de cartes communautaires, pas de relevés topographiques. Les zones enregistrées fonctionnent hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le aree importate provengono da mappe della comunità, non da rilievi. Le aree salvate funzionano offline."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่นำเข้ามาจากแผนที่ชุมชน ไม่ใช่ขอบเขตที่สำรวจแล้ว พื้นที่ที่บันทึกใช้แบบออฟไลน์ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vực nhập từ bản đồ cộng đồng, không phải ranh giới đã đo đạc. Khu vực đã lưu dùng được ngoại tuyến."
          }
        }
      }
    },
