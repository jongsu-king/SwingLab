          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tất phân tích. Hãy thử video khác."
          }
        }
      }
    },
    "Analysis first scans the clip, then samples the swing window at up to 240 frames per second.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis first scans the clip, then samples the swing window at up to 240 frames per second."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석은 먼저 전체 영상을 살핀 다음 스윙 구간을 초당 최대 240프레임으로 샘플링합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずクリップ全体を確認し、スイング区間を毎秒最大240フレームで解析します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析先扫描整个片段，再以每秒最高 240 帧对挥杆区间采样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析會先掃描整個片段，再以每秒最高 240 幀對揮桿區間取樣。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis examina primero el vídeo y luego toma muestras del tramo del swing a hasta 240 fotogramas por segundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise primeiro examina o vídeo e depois amostra o trecho do swing em até 240 quadros por segundo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse prüft zuerst den Clip und tastet dann den Schwungabschnitt mit bis zu 240 Bildern pro Sekunde ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse examine d’abord le clip, puis échantillonne la séquence du swing jusqu’à 240 images par seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi esamina prima il filmato, poi campiona la fase dello swing fino a 240 fotogrammi al secondo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์จะตรวจคลิปทั้งหมดก่อน แล้วเก็บตัวอย่างช่วงวงสวิงสูงสุด 240 เฟรมต่อวินาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình phân tích quét toàn bộ đoạn phim trước, rồi lấy mẫu khoảng vung gậy với tối đa 240 khung hình mỗi giây."
          }
        }
      }
    },
    "Analysis paused because the device is too warm. Let it cool and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis paused because the device is too warm. Let it cool and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 너무 뜨거워 분석이 중단되었습니다. 식힌 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の高温により解析を中断しました。冷ましてから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备过热，分析已暂停。请冷却后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置過熱，分析已暫停。請冷卻後重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis pausado por calor. Deja enfriar el dispositivo y reinténtalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise pausada por aquecimento. Deixe o dispositivo esfriar e tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse wegen Überhitzung angehalten. Lass das Gerät abkühlen und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse interrompue : l’appareil est trop chaud. Laissez-le refroidir et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisi sospesa: dispositivo troppo caldo. Lascialo raffreddare e riprova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดวิเคราะห์เพราะอุปกรณ์ร้อนเกินไป รอให้เย็นแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng phân tích vì thiết bị quá nóng. Để máy nguội rồi thử lại."
          }
        }
      }
    },
    "Analyze again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
