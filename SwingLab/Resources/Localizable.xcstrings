    "Wind, terrain and hazard probabilities: unavailable. MapKit does not supply verified hole geometry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wind, terrain and hazard probabilities: unavailable. MapKit does not supply verified hole geometry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람·지형·해저드 확률은 제공되지 않습니다. MapKit은 검증된 홀 형상을 제공하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風・地形・ハザード確率は利用不可です。MapKitは検証済みホール形状を提供しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风、地形及障碍概率不可用。MapKit不提供经验证的球洞几何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風、地形及障礙機率無法提供。MapKit不提供經驗證的球洞幾何資料。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viento, terreno y probabilidades de obstáculos: no disponibles. MapKit no aporta geometría de hoyos verificada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vento, terreno e probabilidades de obstáculos: indisponíveis. MapKit não fornece geometria validada dos buracos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wind, Gelände und Hinderniswahrscheinlichkeiten nicht verfügbar. MapKit liefert keine geprüfte Lochgeometrie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent, terrain et probabilités d’obstacles indisponibles. MapKit ne fournit pas de géométrie de trous vérifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vento, terreno e probabilità di ostacoli non disponibili. MapKit non fornisce geometrie verificate delle buche."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลลม ภูมิประเทศ และความน่าจะเป็นของอุปสรรค MapKit ไม่ได้ให้รูปทรงหลุมที่ตรวจสอบแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gió, địa hình và xác suất chướng ngại. MapKit không cung cấp hình học hố đã xác minh."
          }
        }
      }
    },
