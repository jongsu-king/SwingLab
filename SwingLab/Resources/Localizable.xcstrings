    "Same camera angle and club, up to 20 earlier analyzed swings. Observations, not faults.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same camera angle and club, up to 20 earlier analyzed swings. Observations, not faults."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 촬영 각도와 클럽으로 이전에 분석한 스윙을 최대 20개까지 비교합니다. 관찰 결과이며 결함 진단이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ撮影アングルとクラブの、以前に分析した最大20スイングと比較します。観察結果であり、欠点の診断ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较同一拍摄角度和球杆下先前分析的最多20次挥杆。仅提供观察结果，不诊断挥杆缺陷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較同一拍攝角度和球桿下先前分析的最多20次揮桿。僅提供觀察結果，不診斷揮桿缺陷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo ángulo de cámara y palo, hasta 20 swings analizados anteriormente. Son observaciones, no fallos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo ângulo de câmera e taco, até 20 swings analisados anteriormente. São observações, não defeitos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Kamerawinkel und Schläger, bis zu 20 zuvor analysierte Schwünge. Beobachtungen, keine Fehlerdiagnosen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même angle de caméra et même club, jusqu’à 20 swings analysés auparavant. Des observations, pas des défauts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stesso bastone e angolazione della fotocamera, fino a 20 swing analizzati in precedenza. Osservazioni, non diagnosi di difetti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบกับสวิงที่วิเคราะห์ก่อนหน้านี้สูงสุด 20 ครั้งจากมุมกล้องและไม้เดียวกัน เป็นข้อสังเกต ไม่ใช่การวินิจฉัยข้อผิดพลาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng góc quay và gậy, tối đa 20 cú swing đã phân tích trước đó. Đây là nhận xét, không phải chẩn đoán lỗi."
          }
        }
      }
    },
    "Same camera angle, up to 20 earlier analyzed swings. Observations, not faults.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same camera angle, up to 20 earlier analyzed swings. Observations, not faults."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 카메라 각도에서 분석한 이전 스윙 최대 20개와 비교합니다. 잘못을 지적하는 것이 아니라 관찰 결과입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じカメラアングルで分析した過去最大20回のスイングと比較します。欠点の指摘ではなく、観察結果です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与同一机位下最多 20 次此前分析过的挥杆比较。这些是观察结果，不是错误判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與同一機位下最多 20 次先前分析過的揮桿比較。這些是觀察結果，不是錯誤判斷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo ángulo de cámara, hasta 20 swings analizados antes. Son observaciones, no fallos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo ângulo de câmera, até 20 swings analisados antes. São observações, não erros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Kamerawinkel, bis zu 20 zuvor analysierte Schwünge. Beobachtungen, keine Fehler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même angle de caméra, jusqu’à 20 swings analysés auparavant. Des observations, pas des fautes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa angolazione, fino a 20 swing analizzati in precedenza. Osservazioni, non errori."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมกล้องเดียวกัน เทียบกับสวิงที่วิเคราะห์ก่อนหน้าสูงสุด 20 ครั้ง เป็นข้อสังเกต ไม่ใช่ข้อผิดพลาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng góc máy, tối đa 20 cú swing đã phân tích trước đó. Đây là nhận xét, không phải lỗi."
          }
        }
      }
    },
    "Same club and camera angle. Review estimated phase markers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same club and camera angle. Review estimated phase markers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 클럽과 카메라 각도입니다. 추정된 단계 마커를 검토하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じクラブとカメラアングルです。推定フェーズマーカーを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同球杆和相机角度。请检查估算的阶段标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同球桿和相機角度。請檢查估計的階段標記。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo palo y ángulo de cámara. Revisa los marcadores de fase estimados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo taco e ângulo de câmera. Revise os marcadores de fase estimados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicher Schläger und Kamerawinkel. Prüfe die geschätzten Phasenmarkierungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même club et même angle de caméra. Vérifiez les repères de phase estimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa mazza e angolazione della fotocamera. Controlla i marcatori di fase stimati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม้และมุมกล้องเดียวกัน ตรวจสอบจุดแบ่งช่วงที่ประมาณไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng gậy và góc camera. Xem lại các mốc giai đoạn ước tính."
          }
        }
      }
    },
