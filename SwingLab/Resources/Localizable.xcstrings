    "GPS shots measure ground displacement, including roll. They do not update carry statistics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS shots measure ground displacement, including roll. They do not update carry statistics."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS 샷은 구름 거리를 포함한 지표 이동 거리를 기록합니다. 캐리 통계는 변경하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSショットはランを含む地表変位です。キャリー統計は更新しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS击球记录含滚动的地面位移，不会更新空中距离统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS擊球記錄含滾動的地面位移，不會更新空中距離統計。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los golpes GPS miden desplazamiento con rodamiento. No actualizan estadísticas de vuelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacadas GPS medem deslocamento com rolagem. Não atualizam estatísticas de carry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-Schläge erfassen Bodenentfernung mit Roll. Carry-Statistiken bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups GPS mesurent le déplacement au sol avec roulement, sans modifier les statistiques de portée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colpi GPS misurano lo spostamento con rotolamento. Non aggiornano le statistiche di carry."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช็อต GPS วัดระยะเคลื่อนที่รวมการกลิ้ง โดยไม่อัปเดตสถิติแคร์รี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cú đánh GPS đo dịch chuyển trên đất, gồm lăn bóng. Không cập nhật thống kê carry."
          }
        }
      }
    },
