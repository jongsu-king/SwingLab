    "Correlation must be greater than −1 and less than 1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correlation must be greater than −1 and less than 1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상관계수는 −1보다 크고 1보다 작아야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相関係数は−1より大きく、1より小さくしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关系数必须大于 −1 且小于 1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關係數必須大於 −1 且小於 1。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La correlación debe ser mayor que −1 y menor que 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A correlação deve ser maior que −1 e menor que 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Korrelation muss größer als −1 und kleiner als 1 sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrélation doit être supérieure à −1 et inférieure à 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La correlazione deve essere maggiore di −1 e minore di 1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สหสัมพันธ์ต้องมากกว่า −1 และน้อยกว่า 1"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ số tương quan phải lớn hơn −1 và nhỏ hơn 1."
          }
        }
      }
    },
