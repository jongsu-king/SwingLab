    "Records use meters, meters per second, and kelvin internally. Display preferences never rewrite measurements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records use meters, meters per second, and kelvin internally. Display preferences never rewrite measurements."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 내부적으로 미터, 초당 미터, 켈빈을 사용합니다. 표시 단위를 바꿔도 측정값은 바뀌지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録は内部でメートル、メートル毎秒、ケルビンを使用します。表示設定で測定値は書き換わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录内部使用米、米/秒和开尔文。显示设置不会改写测量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄內部使用公尺、公尺/秒和克耳文。顯示設定不會改寫測量值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros usan metros, metros por segundo y kelvin internamente. La visualización no modifica las mediciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros usam metros, metros por segundo e kelvin internamente. Preferências de exibição não alteram medições."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intern werden Meter, Meter pro Sekunde und Kelvin verwendet. Anzeigeeinstellungen verändern keine Messwerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données utilisent en interne les mètres, mètres par seconde et kelvins. L’affichage ne modifie pas les mesures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Internamente i dati usano metri, metri al secondo e kelvin. Le preferenze di visualizzazione non modificano le misure."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลภายในใช้เมตร เมตรต่อวินาที และเคลวิน การตั้งค่าการแสดงผลไม่เปลี่ยนค่าที่วัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nội bộ dùng mét, mét/giây và kelvin. Tùy chọn hiển thị không thay đổi số đo."
          }
        }
      }
    },
