    "Analyze both recordings, use the same camera angle, and set address, top, and impact markers to compare tempo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze both recordings, use the same camera angle, and set address, top, and impact markers to compare tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 영상을 분석하고 같은 촬영 각도를 지정한 후 어드레스, 정점, 임팩트 표시를 설정해 템포를 비교하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両動画を解析し、同じ撮影角度でアドレス・トップ・インパクトを設定するとテンポを比較できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析两段录像，使用相同拍摄角度，并设置准备、顶点及触球标记以比较节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析兩段錄影，使用相同拍攝角度，並設定準備、頂點及觸球標記以比較節奏。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza ambas grabaciones con el mismo ángulo y marca colocación, punto alto e impacto para comparar el tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise as duas gravações no mesmo ângulo e marque posição inicial, topo e impacto para comparar o tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere beide Aufnahmen mit gleichem Kamerawinkel und markiere Ansprechposition, Umkehrpunkt und Treffmoment für den Tempovergleich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez les deux vidéos au même angle et marquez adresse, sommet et impact pour comparer le tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza entrambi i video con la stessa angolazione e marca address, apice e impatto per confrontare il tempo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิเคราะห์ทั้งสองวิดีโอ ใช้มุมกล้องเดียวกัน และตั้งเครื่องหมายท่าจรดลูก จุดสูงสุด และอิมแพคเพื่อเทียบจังหวะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích cả hai video, dùng cùng góc quay và đặt mốc vào bóng, đỉnh backswing, tiếp xúc bóng để so sánh nhịp độ."
          }
        }
      }
    },
