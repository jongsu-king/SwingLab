    "Refresh GPS first. Shot recording needs a fix less than 20 seconds old with accuracy within 30 meters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh GPS first. Shot recording needs a fix less than 20 seconds old with accuracy within 30 meters."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 GPS를 새로고침하세요. 샷 기록에는 20초 이내, 정확도 30미터 이내인 위치가 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずGPSを更新してください。記録には20秒以内で精度30メートル以内の位置が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先刷新GPS。击球记录需要20秒内、精度在30米内的定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先更新GPS。擊球記錄需要20秒內、精度在30公尺內的定位。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el GPS. Se necesita una posición de menos de 20 segundos y precisión de 30 metros o mejor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o GPS. É necessária uma posição com menos de 20 segundos e precisão de até 30 metros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS aktualisieren. Erforderlich: Position höchstens 20 Sekunden alt und Genauigkeit innerhalb 30 Metern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez le GPS. Position requise : moins de 20 secondes et précision de 30 mètres maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il GPS. Servono una posizione entro 20 secondi e precisione entro 30 metri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดต GPS ก่อน ต้องใช้ตำแหน่งอายุไม่เกิน 20 วินาทีและคลาดเคลื่อนไม่เกิน 30 เมตร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mới GPS trước. Cần vị trí trong 20 giây với độ chính xác trong 30 mét."
          }
        }
      }
    },
