    "Refresh GPS at the next ball position before finishing this shot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh GPS at the next ball position before finishing this shot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷을 완료하기 전에 다음 공 위치에서 GPS를 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットを完了する前に、次のボール位置でGPSを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成击球前，请在下一个球位刷新GPS。"
          }
        },
        "zh-Hant": {
