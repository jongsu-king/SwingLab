    "Allow camera access to record a swing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access to record a swing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙을 촬영하려면 카메라 접근을 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
