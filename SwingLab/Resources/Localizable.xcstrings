    "Timing depends on marker accuracy. This comparison does not diagnose a swing fault.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing depends on marker accuracy. This comparison does not diagnose a swing fault."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍은 표시의 정확도에 따라 달라집니다. 이 비교는 스윙 결함을 진단하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミングはマーカーの精度に依存します。この比較はスイングの欠点を診断するものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时序取决于标记准确度。此对比不用于诊断挥杆缺陷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時序取決於標記準確度。此比較不用於診斷揮桿缺陷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos dependen de los marcadores. Esta comparación no diagnostica fallos del swing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos dependem da precisão dos marcadores. Esta comparação não diagnostica falhas no swing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing hängt von der Genauigkeit der Markierungen ab. Dieser Vergleich diagnostiziert keine Schwungfehler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rythme dépend de la précision des repères. Cette comparaison ne diagnostique pas un défaut de swing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi dipendono dalla precisione dei marcatori. Il confronto non diagnostica difetti dello swing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จังหวะขึ้นกับความแม่นยำของเครื่องหมาย การเปรียบเทียบนี้ไม่วินิจฉัยข้อบกพร่องของวงสวิง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian phụ thuộc độ chính xác của mốc. So sánh này không chẩn đoán lỗi swing."
          }
        }
      }
    },
