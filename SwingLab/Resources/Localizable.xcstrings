    "You can finish an incomplete round. Unscored holes remain empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can finish an incomplete round. Unscored holes remain empty."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 라운드도 종료할 수 있습니다. 점수가 없는 홀은 비워 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のラウンドも終了できます。未入力ホールは空欄のまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以结束未完成的球局。未记分球洞保持空白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以結束未完成的球局。未計分球洞保持空白。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes finalizar una vuelta incompleta. Los hoyos sin resultado quedan vacíos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode encerrar uma rodada incompleta. Buracos sem pontuação ficam vazios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unvollständige Runden können beendet werden. Ungewertete Löcher bleiben leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez terminer une partie incomplète. Les trous sans score restent vides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi terminare un giro incompleto. Le buche senza punteggio restano vuote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จบรอบที่เล่นไม่ครบได้ หลุมที่ยังไม่บันทึกสกอร์จะว่างไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể kết thúc vòng chưa hoàn tất. Hố chưa ghi điểm vẫn để trống."
          }
        }
      }
    },
