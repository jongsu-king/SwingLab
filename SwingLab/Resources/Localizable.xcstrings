    "Location access is off. Enable it in iPhone Settings to record GPS shots.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Enable it in iPhone Settings to record GPS shots."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근이 꺼져 있습니다. GPS 샷을 기록하려면 iPhone 설정에서 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスが無効です。GPSショットの記録にはiPhoneの設定で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置权限已关闭。请在iPhone设置中开启，以记录GPS击球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置權限已關閉。請在iPhone設定中開啟，以記錄GPS擊球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación desactivada. Actívala en Ajustes del iPhone para registrar golpes GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localização desativada. Ative nos Ajustes do iPhone para registrar tacadas GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortzugriff aus. Zum Erfassen von GPS-Schlägen in den iPhone-Einstellungen aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à la localisation désactivé. Activez-le dans Réglages pour enregistrer les coups GPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla posizione disattivato. Attivalo nelle Impostazioni per registrare colpi GPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงตำแหน่งปิดอยู่ เปิดในตั้งค่า iPhone เพื่อบันทึกช็อต GPS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền vị trí đang tắt. Bật trong Cài đặt iPhone để ghi cú đánh GPS."
          }
        }
      }
    },
    "Location access is used for on-course positioning and GPS shot records while you use the app. GPS accuracy is shown alongside location information.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is used for on-course positioning and GPS shot records while you use the app. GPS accuracy is shown alongside location information."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 중 코스 내 위치와 GPS 샷 기록을 위해 위치 권한을 사용합니다. 위치 정보와 함께 GPS 정확도가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用中のコース上の位置表示とGPSショット記録に位置情報を使います。位置情報とともにGPS精度を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用应用期间，定位权限用于球场定位及 GPS 击球记录。位置旁会显示 GPS 精度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 App 期間，定位權限用於球場定位及 GPS 擊球紀錄。位置旁會顯示 GPS 精度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación se usa mientras utilizas la app para situarte en el campo y registrar golpes GPS. La precisión GPS aparece junto a la ubicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é usada durante o uso do app para posicionamento no campo e registro de tacadas GPS. A precisão GPS é exibida junto à posição."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der App-Nutzung dient der Standort zur Platzpositionierung und GPS-Schlagaufzeichnung. Die GPS-Genauigkeit wird bei der Position angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation sert au positionnement sur le parcours et aux coups GPS pendant l’utilisation. La précision GPS accompagne la position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione serve per orientarti sul campo e registrare colpi GPS durante l’uso dell’app. La precisione GPS è mostrata accanto alla posizione."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตำแหน่งเพื่อแสดงจุดในสนามและบันทึกช็อต GPS ขณะใช้แอป แสดงความแม่นยำ GPS คู่กับตำแหน่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí được dùng để định vị trên sân và ghi cú đánh GPS khi dùng ứng dụng. Độ chính xác GPS hiển thị cùng vị trí."
          }
        }
      }
    },
    "Location services are unavailable. You can still choose targets on the map.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location services are unavailable. You can still choose targets on the map."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 서비스를 사용할 수 없습니다. 지도에서 목표는 선택할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報サービスを利用できません。地図上の目標は選択できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位服务不可用。仍可在地图上选择目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定位服務無法使用。仍可在地圖上選擇目標。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación no disponible. Aún puedes elegir objetivos en el mapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localização indisponível. Você ainda pode escolher alvos no mapa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortdienste nicht verfügbar. Ziele können auf der Karte gewählt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation indisponible. Vous pouvez toujours choisir des cibles sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizzazione non disponibile. Puoi comunque scegliere obiettivi sulla mappa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการตำแหน่งไม่พร้อมใช้งาน แต่ยังเลือกเป้าหมายบนแผนที่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ vị trí không khả dụng. Bạn vẫn có thể chọn mục tiêu trên bản đồ."
          }
        }
      }
    },
