    "drill.countedTempo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drill: count “one-two-three” to the top and “one” down to impact for five swings, then record one and compare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습: 탑까지 “하나-둘-셋”, 임팩트까지 “하나”를 세며 다섯 번 스윙한 뒤 한 번 촬영해 비교하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドリル：トップまで「いち・に・さん」、インパクトまで「いち」と数えて5回スイングし、1回撮影して比べましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习：上杆到顶点数“一、二、三”，下杆到击球数“一”，挥五次后录一次进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習：上桿到頂點數「一、二、三」，下桿到擊球數「一」，揮五次後錄一次進行比較。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio: cuenta “uno-dos-tres” hasta arriba y “uno” hasta el impacto durante cinco swings; luego graba uno y compara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício: conte “um-dois-três” até o topo e “um” até o impacto por cinco swings; depois grave um e compare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung: Zähle bis oben „eins-zwei-drei“ und bis zum Treffmoment „eins“, fünf Schwünge lang; dann einen aufnehmen und vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice : comptez « un-deux-trois » jusqu’en haut et « un » jusqu’à l’impact pendant cinq swings, puis filmez-en un et comparez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio: conta “uno-due-tre” fino in cima e “uno” fino all’impatto per cinque swing, poi registrane uno e confronta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก: นับ “หนึ่ง-สอง-สาม” ถึงจุดสูงสุด และ “หนึ่ง” ถึงจังหวะกระทบ ทำห้าสวิง แล้วบันทึกหนึ่งครั้งเพื่อเปรียบเทียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập: đếm “một-hai-ba” lên đỉnh và “một” xuống chạm bóng trong năm cú swing, rồi quay một cú để so sánh."
          }
        }
      }
    },
    "drill.steadyHeadMirror": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drill: make five slow swings keeping your head against a fixed reference line, then record one and compare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습: 고정된 기준선에 머리를 맞춘 채 천천히 다섯 번 스윙한 뒤 한 번 촬영해 비교하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドリル：頭を固定した基準線に合わせたまま、ゆっくり5回スイングし、1回撮影して比べましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习：让头部对准一条固定参照线，慢速挥五次，然后录一次进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習：讓頭部對準一條固定參考線，慢速揮五次，然後錄一次進行比較。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio: haz cinco swings lentos manteniendo la cabeza junto a una línea de referencia fija; luego graba uno y compara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercício: faça cinco swings lentos mantendo a cabeça junto a uma linha de referência fixa; depois grave um e compare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung: Fünf langsame Schwünge mit dem Kopf an einer festen Referenzlinie; dann einen aufnehmen und vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice : faites cinq swings lents en gardant la tête contre une ligne de référence fixe, puis filmez-en un et comparez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizio: fai cinque swing lenti tenendo la testa allineata a una linea di riferimento fissa, poi registrane uno e confronta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึก: สวิงช้า ๆ ห้าครั้งโดยให้ศีรษะอยู่ตรงกับเส้นอ้างอิงที่คงที่ แล้วบันทึกหนึ่งครั้งเพื่อเปรียบเทียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập: thực hiện năm cú swing chậm, giữ đầu sát một đường tham chiếu cố định, rồi quay một cú để so sánh."
          }
        }
      }
    },
