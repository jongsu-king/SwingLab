    "Phase markers are estimates. Review and correct them before using tempo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase markers are estimates. Review and correct them before using tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계 표시는 추정입니다. 템포를 사용하기 전에 검토하고 수정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェーズマーカーは推定です。テンポを利用する前に確認・修正してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶段标记为估算。使用节奏前请检查并校正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階段標記為估算。使用節奏前請檢查並校正。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores son estimaciones. Revísalos y corrígelos antes de usar el tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os marcadores são estimativas. Revise e corrija antes de usar o tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phasenmarkierungen sind Schätzungen. Prüfe und korrigiere sie vor der Temponutzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères sont des estimations. Vérifiez-les et corrigez-les avant d’utiliser le tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I marcatori sono stime. Verificali e correggili prima di usare il tempo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องหมายช่วงเป็นค่าประมาณ ตรวจสอบและแก้ไขก่อนใช้จังหวะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mốc giai đoạn là ước tính. Kiểm tra và chỉnh lại trước khi dùng nhịp độ."
          }
        }
      }
    },
    "Phase markers must follow chronological order. Clear a conflicting marker or choose another frame.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase markers must follow chronological order. Clear a conflicting marker or choose another frame."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계 표시는 시간순이어야 합니다. 충돌하는 표시를 지우거나 다른 프레임을 선택하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーカーは時系列順に設定してください。競合するマーカーを消すか、別のフレームを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶段标记必须按时间顺序排列。请清除冲突标记或选择其他帧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階段標記必須按時間順序排列。請清除衝突標記或選擇其他影格。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores deben seguir el orden temporal. Borra el que entra en conflicto o elige otro fotograma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os marcadores devem seguir a ordem temporal. Apague o conflitante ou escolha outro quadro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phasen müssen zeitlich geordnet sein. Lösche eine widersprüchliche Markierung oder wähle ein anderes Bild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères doivent suivre l’ordre chronologique. Effacez le repère en conflit ou choisissez une autre image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I marcatori devono essere in ordine cronologico. Cancella quello in conflitto o scegli un altro fotogramma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องหมายต้องเรียงตามเวลา ล้างเครื่องหมายที่ขัดกันหรือเลือกเฟรมอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mốc phải theo thứ tự thời gian. Xóa mốc xung đột hoặc chọn khung hình khác."
          }
        }
      }
    },
