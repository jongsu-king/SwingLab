    "Gross scores from fully scored, completed 18-hole rounds. Course difficulty is not adjusted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gross scores from fully scored, completed 18-hole rounds. Course difficulty is not adjusted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료된 18홀 라운드에서 모든 홀의 스코어가 입력된 경우만 포함합니다. 코스 난이도는 보정하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全ホール記入済みで終了した18ホールラウンドのグロススコアです。コース難度は補正しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自已结束且全部记分的 18 洞轮次的总杆数，未调整球场难度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自已結束且全部記分的 18 洞回合的總桿數，未調整球場難度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados brutos de rondas de 18 hoyos finalizadas y totalmente anotadas. Sin ajuste por dificultad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuações brutas de rodadas de 18 buracos concluídas e totalmente anotadas. Sem ajuste de dificuldade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruttoscores vollständig erfasster, beendeter 18-Loch-Runden. Ohne Anpassung an die Platzschwierigkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores bruts de parties de 18 trous terminées et entièrement renseignées. Difficulté du parcours non corrigée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggi lordi di giri di 18 buche conclusi e compilati. Nessun adeguamento alla difficoltà del campo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนรวมจากรอบ 18 หลุมที่จบและกรอกคะแนนครบ ไม่ปรับตามความยากสนาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm tổng của vòng 18 hố đã kết thúc và ghi đủ điểm. Không điều chỉnh theo độ khó sân."
          }
        }
      }
    },
