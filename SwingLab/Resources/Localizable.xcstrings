    "User-entered. Carry is the distance through the air; total includes roll. Leave unknown values blank.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-entered. Carry is the distance through the air; total includes roll. Leave unknown values blank."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 입력값입니다. 캐리는 공중 이동 거리이며 총거리는 구르는 거리를 포함합니다. 모르는 값은 비워 두세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー入力です。キャリーは空中を飛ぶ距離、総距離は転がりを含む距離です。不明な値は空欄にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入。飞行距离指空中距离，总距离包含滚动。未知数值请留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者輸入。飛行距離指空中距離，總距離包含滾動。未知數值請留空。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del usuario. El vuelo es la distancia aérea; el total incluye la rodada. Deja vacíos los valores desconocidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados do usuário. Voo é a distância no ar; o total inclui o rolamento. Deixe valores desconhecidos em branco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzereingabe. Carry ist die Flugdistanz; die Gesamtdistanz umfasst das Rollen. Unbekannte Werte leer lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie utilisateur. La portée est la distance en vol ; le total inclut la roule. Laissez les valeurs inconnues vides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati dell’utente. Il volo è la distanza in aria; il totale include il rotolamento. Lascia vuoti i valori sconosciuti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้กรอก ระยะลอยคือระยะในอากาศ ระยะรวมรวมการกลิ้ง เว้นว่างค่าที่ไม่ทราบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do người dùng nhập. Khoảng cách bay là quãng đường trên không; tổng gồm cả lăn. Để trống giá trị chưa biết."
          }
        }
      }
    },
