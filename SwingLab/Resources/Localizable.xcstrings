    "Language and measurement units are independent. Changing either keeps your records.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language and measurement units are independent. Changing either keeps your records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어와 측정 단위는 독립적으로 설정됩니다. 변경해도 기록은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語と単位は別々に設定できます。変更しても記録は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言和计量单位可独立设置。更改任一设置都会保留记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言和計量單位可獨立設定。變更任一設定都會保留紀錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma y las unidades son independientes. Cambiarlos conserva tus registros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma e unidades são independentes. Alterá-los mantém seus registros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache und Maßeinheiten sind unabhängig. Änderungen erhalten deine Aufzeichnungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue et les unités sont indépendantes. Les modifier conserve vos données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingua e unità sono indipendenti. Modificarle conserva i tuoi dati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาและหน่วยวัดตั้งค่าแยกกันได้ การเปลี่ยนไม่ลบบันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ và đơn vị đo độc lập. Thay đổi không làm mất bản ghi."
          }
        }
      }
    },
