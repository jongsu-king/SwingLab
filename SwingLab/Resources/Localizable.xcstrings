    "You can finish an incomplete round. Unscored holes remain empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can finish an incomplete round. Unscored holes remain empty."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 라운드도 종료할 수 있습니다. 점수가 없는 홀은 비워 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のラウンドも終了できます。未入力ホールは空欄のまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
