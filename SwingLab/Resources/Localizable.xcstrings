    "A better game,\none swing at a time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A better game,\none swing at a time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스윙 하나하나로,\n더 나은 골프를."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一振りずつ、\nよりよいゴルフへ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次挥杆，\n都让球技更进一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次揮桿，\n都讓球技更進一步。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu juego,\nswing a swing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo melhor,\num swing de cada vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besser spielen,\nSchwung für Schwung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un meilleur jeu,\nswing après swing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco migliore,\nuno swing alla volta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นให้ดีขึ้น\nทีละสวิง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi tốt hơn,\nqua từng cú swing."
          }
        }
      }
    },
    "A closer look\nat your swing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closer look\nat your swing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스윙을\n더 자세히."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイングを、\nもっと詳しく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更仔细地\n观察挥杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更仔細地\n觀察揮桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu swing,\nmás de cerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu swing,\nmais de perto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schwung,\ngenauer betrachtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre swing,\nvu de plus près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo swing,\nda vicino."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองวงสวิงของคุณ\nให้ชัดยิ่งขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn kỹ hơn\ncú swing của bạn."
          }
        }
      }
    },
