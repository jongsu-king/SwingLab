    "GPS records the distance between two positions. It includes roll and GPS uncertainty, and is not measured airborne carry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS records the distance between two positions. It includes roll and GPS uncertainty, and is not measured airborne carry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS는 두 위치 사이의 거리를 기록합니다. 구름 거리와 GPS 오차가 포함되며, 공중 비행 거리 측정값이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSは2地点間の距離を記録します。ランとGPS誤差を含み、実測キャリーではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS记录两点间的距离，包含滚动和GPS误差，不是实测空中距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS記錄兩點間的距離，包含滾動和GPS誤差，不是實測空中距離。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS registra la distancia entre posiciones, incluido el rodamiento y su incertidumbre. No mide el vuelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS registra a distância entre posições, incluindo rolagem e incerteza. Não mede carry aéreo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS erfasst die Entfernung zwischen Positionen, einschließlich Roll und GPS-Unsicherheit. Kein gemessener Carry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS mesure la distance entre deux positions, roulement et incertitude compris. Ce n’est pas une portée aérienne mesurée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il GPS registra la distanza tra posizioni, inclusi rotolamento e incertezza. Non misura il carry in volo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS บันทึกระยะระหว่างสองตำแหน่ง รวมการกลิ้งและความคลาดเคลื่อน ไม่ใช่การวัดระยะลอยตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS ghi khoảng cách giữa hai vị trí, gồm lăn bóng và sai số GPS; đây không phải carry trên không đo được."
          }
        }
      }
    },
