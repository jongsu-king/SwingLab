    "Simulate a ball flight from launch values you enter. SwingLab does not measure these from video.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate a ball flight from launch values you enter. SwingLab does not measure these from video."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 발사 값으로 공의 비행을 시뮬레이션합니다. SwingLab은 이 값을 영상에서 측정하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した打ち出し値からボールの弾道をシミュレーションします。SwingLabはこれらの値を動画から測定しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你输入的起飞参数模拟球的飞行。SwingLab 不会从视频中测量这些数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你輸入的起飛參數模擬球的飛行。SwingLab 不會從影片中測量這些數值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula el vuelo de la bola con los valores de salida que introduzcas. SwingLab no mide estos valores a partir del video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule o voo da bola com os valores de lançamento que você inserir. O SwingLab não mede esses valores pelo vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuliert einen Ballflug aus den Abflugwerten, die du eingibst. SwingLab misst diese Werte nicht aus dem Video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulez le vol de la balle à partir des valeurs de lancement que vous saisissez. SwingLab ne mesure pas ces valeurs à partir de la vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula il volo della palla con i valori di lancio che inserisci. SwingLab non misura questi valori dal video."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำลองวิถีลูกจากค่าการออกตัวที่คุณป้อน SwingLab ไม่ได้วัดค่าเหล่านี้จากวิดีโอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô phỏng đường bay của bóng từ các giá trị phóng bạn nhập. SwingLab không đo các giá trị này từ video."
          }
        }
      }
    },
