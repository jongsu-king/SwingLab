            "value": "참고값은 내 측정값으로 저장되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考値があなたの測定値になることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考值不会成为你的测量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考值不會成為你的測量值。"
          }
        },
