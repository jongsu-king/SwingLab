    "Published groups describe other golfers. They are context, not targets or personal predictions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published groups describe other golfers. They are context, not targets or personal predictions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발표된 집단은 다른 골퍼의 데이터입니다. 배경 정보이며 목표나 개인 예측값이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公表された集団は他のゴルファーのデータです。参考情報であり、目標や個人の予測値ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已公布的数据来自其他球手，仅供参考，不是目标或个人预测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已公布的資料來自其他球手，僅供參考，不是目標或個人預測。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos publicados describen a otros golfistas. Son contexto, no objetivos ni predicciones personales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos publicados descrevem outros golfistas. São contexto, não metas nem previsões pessoais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die veröffentlichten Gruppen beschreiben andere Golfer. Sie dienen der Einordnung, nicht als Ziele oder persönliche Vorhersagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes publiés décrivent d’autres golfeurs. Ils apportent du contexte, pas des objectifs ni des prévisions personnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi pubblicati descrivono altri golfisti. Sono un contesto, non obiettivi o previsioni personali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลกลุ่มที่เผยแพร่เป็นข้อมูลของนักกอล์ฟคนอื่น ใช้เป็นบริบท ไม่ใช่เป้าหมายหรือการคาดการณ์ส่วนบุคคล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhóm đã công bố mô tả những người chơi khác. Đây là thông tin tham khảo, không phải mục tiêu hay dự đoán cá nhân."
          }
        }
      }
    },
    "Putter": {
