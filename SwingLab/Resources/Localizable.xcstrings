    "Check the score. Putts and penalties cannot exceed total strokes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the score. Putts and penalties cannot exceed total strokes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수를 확인하세요. 퍼트와 벌타의 합은 전체 타수를 넘을 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアを確認してください。パットとペナルティの合計は総打数を超えられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查分数。推杆与罚杆之和不能超过总杆数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查分數。推桿與罰桿之和不能超過總桿數。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el resultado. Putts y penalizaciones no pueden superar los golpes totales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a pontuação. Putts e penalidades não podem superar o total de tacadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Score prüfen. Putts plus Strafschläge dürfen die Gesamtschläge nicht übersteigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le score. Putts et pénalités ne peuvent dépasser le total des coups."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il punteggio. Putt e penalità non possono superare i colpi totali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสกอร์ ผลรวมพัตต์และโทษปรับต้องไม่เกินสโตรกรวม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra điểm. Tổng putt và gậy phạt không được vượt tổng số gậy."
          }
        }
      }
    },
    "Choose a video shorter than three minutes.": {
      "extractionState": "manual",
      "localizations": {
