    "Use at least three distinct points without crossing edges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least three distinct points without crossing edges."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 다른 점을 세 개 이상 사용하고 선이 교차하지 않게 하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異なる点を3つ以上使い、辺が交差しないようにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用至少三个不同点，且边不能交叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用至少三個不同點，且邊不能交叉。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa al menos tres puntos distintos sin cruzar los bordes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos três pontos distintos sem cruzar as bordas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens drei verschiedene Punkte ohne sich kreuzende Kanten verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez au moins trois points distincts sans croiser les bords."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa almeno tre punti distinti senza incrociare i lati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้จุดที่ต่างกันอย่างน้อยสามจุดโดยเส้นขอบไม่ตัดกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ít nhất ba điểm khác nhau, các cạnh không giao nhau."
          }
        }
