    "Different frame rates. Timing precision may differ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different frame rates. Timing precision may differ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 속도가 다릅니다. 시간 정밀도가 다를 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレートが異なります。時間の精度が異なる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率不同，时间精度可能有所差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幀率不同，時間精度可能有所差異。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frecuencias de fotogramas son distintas. La precisión temporal puede variar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas de quadros são diferentes. A precisão temporal pode variar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterschiedliche Bildraten. Die zeitliche Genauigkeit kann abweichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fréquences d’images diffèrent. La précision temporelle peut varier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frequenze dei fotogrammi sono diverse. La precisione temporale può variare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราเฟรมต่างกัน ความแม่นยำด้านเวลาอาจแตกต่างกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ khung hình khác nhau. Độ chính xác thời gian có thể khác nhau."
          }
        }
      }
    },
    "Different handedness. Movement comparisons may be misleading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different handedness. Movement comparisons may be misleading."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주사용 손이 다릅니다. 동작 비교가 오해를 낳을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利き手が異なります。動作の比較が誤解を招く可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "惯用手不同，动作对比可能产生误导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慣用手不同，動作比較可能產生誤導。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano dominante es distinta. La comparación del movimiento puede ser engañosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão dominante é diferente. A comparação dos movimentos pode ser enganosa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterschiedliche Spielhand. Bewegungsvergleiche können irreführend sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latéralité diffère. La comparaison des mouvements peut être trompeuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano dominante è diversa. Il confronto dei movimenti può essere fuorviante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือถนัดต่างกัน การเปรียบเทียบการเคลื่อนไหวอาจทำให้เข้าใจผิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay thuận khác nhau. So sánh chuyển động có thể gây hiểu lầm."
          }
        }
      }
    },
    "Different or unspecified camera angles. Movement comparisons may be misleading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different or unspecified camera angles. Movement comparisons may be misleading."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 각도가 다르거나 지정되지 않았습니다. 움직임 비교가 부정확할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影角度が異なるか未指定です。動きの比較を誤解する可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄角度不同或未指定。动作对比可能产生误导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝角度不同或未指定。動作比較可能產生誤導。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ángulos distintos o sin especificar. La comparación puede resultar engañosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ângulos diferentes ou não especificados. A comparação pode ser enganosa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abweichende oder unbekannte Kamerawinkel. Bewegungsvergleiche können irreführend sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Angles différents ou non précisés. La comparaison peut être trompeuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Angolazioni diverse o non specificate. Il confronto può essere fuorviante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมกล้องต่างกันหรือไม่ได้ระบุ การเทียบการเคลื่อนไหวอาจทำให้เข้าใจผิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góc quay khác nhau hoặc chưa xác định. So sánh chuyển động có thể gây hiểu nhầm."
          }
        }
      }
    },
