            "value": "Know the spaces between clubs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클럽 간 거리 차이를 알아보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラブ間の距離差を知る。"
          }
        },
        "zh-Hans": {
