    "Analysis could not be completed. Please try another video.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis could not be completed. Please try another video."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석을 완료하지 못했습니다. 다른 영상으로 시도하세요."
          }
        },
        "ja": {
