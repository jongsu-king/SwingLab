        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too dark for a 1/%2$@ s shutter at %1$@ fps: the image will be dim. Move to brighter light."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@fps에서 셔터 1/%2$@초로 찍기에는 너무 어두워 화면이 어둡게 나옵니다. 더 밝은 곳으로 옮기세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@fpsでシャッター1/%2$@秒には暗すぎるため、映像が暗くなります。明るい場所へ移動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ fps、快门 1/%2$@ 秒下光线过暗，画面会偏暗。请移到更明亮的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ fps、快門 1/%2$@ 秒下光線過暗，畫面會偏暗。請移到更明亮的地方。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay muy poca luz para un obturador de 1/%2$@ s a %1$@ fps: la imagen saldrá oscura. Busca más luz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está escuro demais para um obturador de 1/%2$@ s a %1$@ fps: a imagem ficará escura. Procure mais luz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dunkel für 1/%2$@ s Verschluss bei %1$@ fps: Das Bild wird dunkel. Such dir helleres Licht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop sombre pour un obturateur de 1/%2$@ s à %1$@ i/s : l’image sera sombre. Allez vers plus de lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo buio per un otturatore di 1/%2$@ s a %1$@ fps: l’immagine sarà scura. Spostati dove c’è più luce."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มืดเกินไปสำหรับชัตเตอร์ 1/%2$@ วินาทีที่ %1$@ fps ภาพจะมืด ให้ย้ายไปที่สว่างกว่านี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá tối cho màn trập 1/%2$@ giây ở %1$@ fps: hình sẽ bị tối. Hãy chuyển tới nơi sáng hơn."
          }
        }
      }
    },
