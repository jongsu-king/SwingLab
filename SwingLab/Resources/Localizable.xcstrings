    "Search uses Apple Maps and needs internet access. Results are places, not verified hole layouts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search uses Apple Maps and needs internet access. Results are places, not verified hole layouts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 Apple 지도를 사용하며 인터넷이 필요합니다. 결과는 장소 정보이며 검증된 홀 배치가 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索はAppleマップを使用し、インターネットが必要です。結果は施設情報で、検証済みのホール形状ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索使用Apple地图并需要联网。结果为地点信息，不是经验证的球洞布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋使用Apple地圖並需要連網。結果為地點資訊，不是經驗證的球洞配置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda usa Mapas de Apple y necesita internet. Los resultados son lugares, no planos de hoyos verificados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca usa Mapas da Apple e requer internet. Os resultados são locais, não layouts de buracos validados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche über Apple Karten mit Internet. Ergebnisse sind Orte, keine geprüften Lochpläne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche utilise Plans d’Apple avec internet. Les résultats sont des lieux, pas des tracés de trous vérifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca usa Mappe di Apple e richiede internet. I risultati sono luoghi, non tracciati di buche verificati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาใช้ Apple Maps และต้องมีอินเทอร์เน็ต ผลลัพธ์เป็นสถานที่ ไม่ใช่ผังหลุมที่ตรวจสอบแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm dùng Apple Maps và cần internet. Kết quả là địa điểm, không phải sơ đồ hố đã xác minh."
          }
        }
      }
    },
