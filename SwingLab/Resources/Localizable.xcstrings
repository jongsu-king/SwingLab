          }
        }
      }
    },
    "Camera, microphone, and location access are requested only when you use them. No account required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera, microphone, and location access are requested only when you use them. No account required."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라, 마이크, 위치 접근 권한은 해당 기능을 사용할 때만 요청합니다. 계정이 필요하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ、マイク、位置情報へのアクセスは、使用時にのみ求められます。アカウントは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在使用时请求相机、麦克风和位置权限。无需账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在使用時要求相機、麥克風和位置權限。無需帳號。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos de cámara, micrófono y ubicación solo se solicitan al usarlos. No necesitas una cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera, ao microfone e à localização só é solicitado quando você os usa. Não é necessário ter uma conta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Kamera, Mikrofon und Standort wird nur bei Nutzung angefragt. Kein Konto erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la caméra, au microphone et à la position n’est demandé que lors de leur utilisation. Aucun compte requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a fotocamera, microfono e posizione viene richiesto solo quando li usi. Non serve un account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอสิทธิ์เข้าถึงกล้อง ไมโครโฟน และตำแหน่งเมื่อใช้งานเท่านั้น ไม่ต้องมีบัญชี"
