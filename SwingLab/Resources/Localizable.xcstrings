        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลบางส่วนไม่ได้ ลองอีกครั้งก่อนออกจากหน้านี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa một số dữ liệu. Hãy thử lại trước khi rời màn hình này."
          }
        }
      }
    },
