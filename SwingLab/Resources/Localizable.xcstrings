    "Permission access can be changed at any time in the iPhone Settings app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission access can be changed at any time in the iPhone Settings app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정 앱에서 언제든 접근 권한을 변경할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス許可はiPhoneの設定アプリでいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在 iPhone 设置中更改权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在 iPhone 設定中變更權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar los permisos cuando quieras en Ajustes del iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar as permissões a qualquer momento nos Ajustes do iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen lassen sich jederzeit in den iPhone-Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier les autorisations à tout moment dans Réglages sur l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare le autorizzazioni in qualsiasi momento nelle Impostazioni di iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนสิทธิ์ได้ทุกเมื่อในแอปการตั้งค่าของ iPhone"
