    "Aim %1$@ left of the target.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim %1$@ left of the target."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 왼쪽 %1$@ 지점을 조준하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の左%1$@を狙います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
