    "Analyze and review phase markers on at least two recordings to compare tempo. Missing measurements stay blank.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze and review phase markers on at least two recordings to compare tempo. Missing measurements stay blank."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 두 개 이상을 분석하고 구간 표시를 검토하면 템포를 비교할 수 있습니다. 없는 측정값은 비워 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本以上の動画を解析し、フェーズマーカーを確認するとテンポを比較できます。測定値がない項目は空欄です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析并检查至少两段录像的阶段标记，即可比较节奏。缺失的测量值保持空白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析並檢查至少兩段錄影的階段標記，即可比較節奏。缺少的測量值保持空白。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza y revisa las fases de al menos dos grabaciones para comparar el tempo. Las mediciones ausentes quedan vacías."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise e revise as fases de pelo menos duas gravações para comparar o ritmo. Medições ausentes ficam em branco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere mindestens zwei Aufnahmen und prüfe die Phasenmarkierungen für einen Tempovergleich. Fehlende Messwerte bleiben leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez et vérifiez les phases d’au moins deux vidéos pour comparer le tempo. Les mesures manquantes restent vides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza e verifica le fasi di almeno due registrazioni per confrontare il tempo. Le misure mancanti restano vuote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิเคราะห์และตรวจจุดแบ่งเฟสอย่างน้อยสองวิดีโอเพื่อเปรียบเทียบจังหวะ ค่าที่ไม่มีจะเว้นว่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích và kiểm tra mốc pha trong ít nhất hai video để so sánh nhịp độ. Số đo thiếu sẽ để trống."
          }
        }
      }
    },
