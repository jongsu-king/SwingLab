    "No account is required. You control the recordings, clubs, and rounds saved on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. You control the recordings, clubs, and rounds saved on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요하지 않습니다. 이 iPhone에 저장된 영상, 클럽, 라운드를 직접 관리합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。このiPhoneの動画、クラブ、ラウンドを自分で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户。你可以管理保存在此 iPhone 上的录像、球杆和轮次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需帳號。你可以管理儲存在此 iPhone 上的錄影、球桿和回合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas cuenta. Controlas las grabaciones, palos y rondas guardados en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta é necessária. Você controla as gravações, os tacos e as rodadas salvos neste iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto erforderlich. Du verwaltest Aufnahmen, Schläger und Runden auf diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte requis. Vous contrôlez les vidéos, clubs et parties enregistrés sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve un account. Gestisci registrazioni, bastoni e giri salvati su questo iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี คุณควบคุมวิดีโอ ไม้กอล์ฟ และรอบที่เก็บบน iPhone นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Bạn quản lý video, gậy và vòng chơi lưu trên iPhone này."
          }
        }
      }
    },
    "No changes exceeded the comparison threshold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No changes exceeded the comparison threshold."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교 기준을 넘는 변화가 없었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較基準を超える変化はありませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有变化超出比较阈值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有變化超出比較門檻。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún cambio superó el umbral de comparación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mudança ultrapassou o limite de comparação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Veränderung überschritt den Vergleichsschwellenwert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun changement n’a dépassé le seuil de comparaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun cambiamento ha superato la soglia di confronto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเปลี่ยนแปลงที่เกินเกณฑ์การเปรียบเทียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thay đổi nào vượt ngưỡng so sánh."
          }
        }
      }
    },
    "No clear impact sound after the top, so impact is a pose estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clear impact sound after the top, so impact is a pose estimate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탑 이후 뚜렷한 타구음이 없어 임팩트는 자세 기반 추정입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トップの後に明確な打球音がないため、インパクトは姿勢からの推定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上杆顶点之后没有清晰的击球声，击球时刻为姿态估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上桿頂點之後沒有清晰的擊球聲，擊球時刻為姿態估算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un sonido de impacto claro después del punto más alto, así que el impacto es una estimación por postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há um som de impacto claro após o topo, então o impacto é uma estimativa pela postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem höchsten Punkt gibt es kein klares Schlaggeräusch, daher ist der Treffmoment eine Schätzung aus der Haltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun son d’impact net après le haut du swing ; l’impact est une estimation d’après la posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suono d’impatto chiaro dopo la sommità, quindi l’impatto è una stima dalla postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเสียงกระทบที่ชัดเจนหลังจุดสูงสุด จังหวะกระทบจึงเป็นค่าประมาณจากท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tiếng chạm bóng rõ ràng sau đỉnh swing, nên thời điểm chạm bóng là ước tính từ tư thế."
