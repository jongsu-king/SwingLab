    "Tap the ball where it sits now. Shots are measured from this spot until you change it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the ball where it sits now. Shots are measured from this spot until you change it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 놓인 공을 누르세요. 위치를 바꿀 때까지 이 자리에서 친 샷을 측정해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今置いてあるボールをタップしてください。変更するまでこの位置からのショットを計測します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点现在放置的球。在更改之前，都会测量从此位置击出的球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點現在放置的球。在更改之前，都會測量從此位置擊出的球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la bola donde está ahora. Se medirán los golpes desde este punto hasta que lo cambies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na bola onde ela está agora. As tacadas são medidas a partir deste ponto até você mudá-lo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Ball, wo er gerade liegt. Schläge werden von dieser Stelle aus gemessen, bis du sie änderst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la balle là où elle se trouve. Les coups sont mesurés depuis cet endroit jusqu'à ce que vous le changiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la palla dove si trova ora. I colpi vengono misurati da questo punto finché non lo cambi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่ลูกตรงตำแหน่งที่วางอยู่ตอนนี้ จะวัดช็อตจากจุดนี้จนกว่าคุณจะเปลี่ยน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào bóng ở vị trí hiện tại. Các cú đánh được đo từ vị trí này cho đến khi bạn thay đổi."
          }
        }
      }
    },
    "Tap the centre of the ball at address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the centre of the ball at address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어드레스 때 공의 중앙을 탭하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス時のボールの中心をタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请轻点准备击球时球的中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輕點準備擊球時球的中心。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el centro de la bola en el address."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no centro da bola no address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Mitte des Balls in der Ansprechposition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le centre de la balle à l’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il centro della palla all’address."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่กึ่งกลางลูกในท่าแอดเดรส"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào tâm quả bóng ở tư thế chuẩn bị."
          }
        }
      }
    },
    "Tap the club head at address. Tracking stops at the top or at the first loss of confidence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the club head at address. Tracking stops at the top or at the first loss of confidence."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어드레스의 클럽 헤드를 탭하세요. 추적은 탑 또는 처음 신뢰도가 낮아지는 지점에서 중단됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス時のクラブヘッドをタップします。追跡はトップまたは最初に信頼度が下がった時点で停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按站位时的杆头。追踪在顶点或首次置信度下降时停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下站位時的桿頭。追蹤在頂點或首次信賴度下降時停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la cabeza del palo en la colocación. El seguimiento termina arriba o al perder confianza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na cabeça do taco na posição inicial. O rastreamento para no topo ou na primeira perda de confiança."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägerkopf in der Ansprechposition antippen. Die Verfolgung endet am höchsten Punkt oder beim ersten Vertrauensverlust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la tête du club à l’adresse. Le suivi s’arrête au sommet ou dès la première perte de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la testa del bastone all’address. Il tracciamento termina al vertice o alla prima perdita di affidabilità."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะหัวไม้ตอนจรดลูก การติดตามหยุดที่จุดสูงสุดหรือเมื่อความมั่นใจลดลงครั้งแรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm đầu gậy ở tư thế chuẩn bị. Theo dõi dừng ở đỉnh hoặc khi độ tin cậy giảm lần đầu."
          }
        }
      }
    },
    "Tap the location button for GPS, or place a ball position on the map.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the location button for GPS, or place a ball position on the map."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 버튼으로 GPS를 요청하거나 지도에 공 위치를 표시하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置ボタンでGPSを取得するか、地図上にボール位置を配置してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击定位按钮获取GPS，或在地图上设置球位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選定位按鈕取得GPS，或在地圖上設定球位。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ubicación para obtener GPS o coloca la bola en el mapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em localização para usar GPS ou marque a bola no mapa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standorttaste für GPS antippen oder Ballposition auf Karte setzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la localisation pour le GPS ou placez la balle sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la posizione per il GPS o posiziona la palla sulla mappa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มตำแหน่งเพื่อใช้ GPS หรือวางตำแหน่งลูกบนแผนที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm nút vị trí để dùng GPS hoặc đặt vị trí bóng trên bản đồ."
          }
        }
      }
    },
    "Tap the map to place the selected reference. Drag the target flag to adjust your aim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to place the selected reference. Drag the target flag to adjust your aim."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 탭하여 선택한 참고 지점을 표시하세요. 목표 깃발을 드래그해 조준점을 조정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップして参考点を配置します。目標の旗をドラッグして狙いを調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击地图放置所选参考点。拖动目标旗调整瞄准点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選地圖放置所選參考點。拖曳目標旗調整瞄準點。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el mapa para colocar la referencia. Arrastra la bandera para ajustar el objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no mapa para marcar a referência. Arraste a bandeira para ajustar a mira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte antippen, um Referenz zu setzen. Zielfahne ziehen, um die Richtung anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour placer le repère. Faites glisser le drapeau pour ajuster la visée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la mappa per inserire il riferimento. Trascina la bandiera per regolare la mira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแผนที่เพื่อวางจุดอ้างอิงที่เลือก ลากธงเป้าหมายเพื่อปรับแนวเล็ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm bản đồ để đặt điểm tham chiếu. Kéo cờ mục tiêu để chỉnh hướng ngắm."
          }
        }
      }
    },
    "Tap to add polygon vertices. Select an area to replace its outline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to add polygon vertices. Select an area to replace its outline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 다각형 꼭짓점을 추가하세요. 영역을 선택하면 윤곽을 바꿀 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして多角形の頂点を追加します。輪郭を変更するにはエリアを選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按添加多边形顶点。选择区域可替换轮廓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下加入多邊形頂點。選擇區域可替換輪廓。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para añadir vértices. Selecciona una zona para reemplazar su contorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para adicionar vértices. Selecione uma área para substituir seu contorno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen fügt Eckpunkte hinzu. Eine Fläche auswählen, um ihren Umriss zu ersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour ajouter des sommets. Sélectionnez une zone pour remplacer son contour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per aggiungere vertici. Seleziona un’area per sostituirne il contorno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเพิ่มจุดยอดรูปหลายเหลี่ยม เลือกพื้นที่เพื่อเปลี่ยนเส้นขอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để thêm đỉnh đa giác. Chọn khu vực để thay đường viền."
          }
        }
      }
    },
