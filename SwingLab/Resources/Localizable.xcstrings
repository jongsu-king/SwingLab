    "Add your own carry distances in My Bag to compare club gaps. Unknown distances stay empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your own carry distances in My Bag to compare club gaps. Unknown distances stay empty."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이백에 캐리 거리를 입력해 클럽 간 거리 차이를 비교하세요. 모르는 거리는 비워 두세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイバッグにキャリーを入力してクラブ間の距離差を比較しましょう。不明な距離は空欄のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球包中输入飞行距离，比较球杆间距。不确定的距离留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的球袋中輸入飛行距離，比較球桿間距。不確定的距離留空。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus distancias de vuelo en Mi bolsa para comparar intervalos. Deja vacíos los valores desconocidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione suas distâncias de voo em Minha bolsa para comparar intervalos. Deixe valores desconhecidos em branco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage deine Carry-Distanzen unter Meine Tasche ein, um Abstände zu vergleichen. Unbekannte Distanzen bleiben leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vos portées dans Mon sac pour comparer les écarts. Laissez les distances inconnues vides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci le distanze di volo in La mia sacca per confrontare gli intervalli. Lascia vuoti i valori sconosciuti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
