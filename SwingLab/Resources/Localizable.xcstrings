    "Pose is vision-derived 2D image geometry, not a 3D body measurement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose is vision-derived 2D image geometry, not a 3D body measurement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자세는 영상에서 도출된 2D 기하 정보이며 신체의 3D 측정이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "姿勢は画像から推定した2D形状であり、身体の3D測定ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姿态是视觉推导的二维图像几何信息，并非三维身体测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "姿態是視覺推導的二維影像幾何資訊，並非三維身體測量。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La postura es geometría 2D derivada de visión, no una medición corporal 3D."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A postura é geometria 2D derivada de visão, não uma medição corporal 3D."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Körperpose ist bildbasierte 2D-Geometrie, keine 3D-Körpermessung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La posture est une géométrie 2D issue de la vision, pas une mesure corporelle 3D."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La postura è geometria 2D derivata dalla visione, non una misura corporea 3D."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท่าทางเป็นเรขาคณิตภาพ 2 มิติที่ได้จากการมองเห็น ไม่ใช่การวัดร่างกาย 3 มิติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tư thế là hình học ảnh 2D suy ra từ thị giác, không phải phép đo cơ thể 3D."
          }
        }
      }
    },
