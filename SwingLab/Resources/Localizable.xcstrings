    "No reliable body pose was found. Keep one golfer fully visible in good light.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reliable body pose was found. Keep one golfer fully visible in good light."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 자세를 찾지 못했습니다. 밝은 곳에서 한 골퍼의 전신이 보이게 하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる姿勢を検出できませんでした。明るい場所で1人の全身を映してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可靠姿态。请在光线充足时让一名球手全身可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可靠姿態。請在光線充足時讓一名球手全身可見。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó una postura fiable. Encuadra a un solo golfista de cuerpo entero y con buena luz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma postura confiável encontrada. Enquadre um golfista inteiro com boa iluminação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
