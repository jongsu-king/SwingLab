    "Recording could not be saved. Check available storage and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording could not be saved. Check available storage and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 기록을 저장하지 못했습니다. 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画を保存できませんでした。空き容量を確認して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存录像。请检查存储空间后重试。"
