    "Spoken feedback uses an available voice for your selected language. If a suitable voice is unavailable, feedback stays on screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoken feedback uses an available voice for your selected language. If a suitable voice is unavailable, feedback stays on screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어에 사용 가능한 음성으로 피드백을 읽어줍니다. 적절한 음성이 없으면 화면에만 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した言語で利用可能な音声を使います。対応音声がない場合は画面上のテキストで表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音反馈使用所选语言的可用语音。若无适合语音，反馈仍会显示在屏幕上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音回饋使用所選語言的可用語音。若無適合語音，回饋仍會顯示在螢幕上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios hablados usan una voz disponible del idioma elegido. Si no hay una adecuada, los comentarios quedan en pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feedback falado usa uma voz disponível no idioma escolhido. Se não houver voz adequada, o feedback fica na tela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprochenes Feedback nutzt eine verfügbare Stimme deiner Sprache. Fehlt eine passende Stimme, bleibt das Feedback auf dem Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conseils utilisent une voix disponible dans la langue choisie. Sans voix adaptée, ils restent affichés à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback vocale usa una voce disponibile nella lingua scelta. Se manca una voce adatta, il testo resta sullo schermo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เสียงที่มีสำหรับภาษาที่เลือก หากไม่มีเสียงที่เหมาะสม คำแนะนำจะแสดงบนหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi dùng giọng có sẵn cho ngôn ngữ đã chọn. Nếu không có giọng phù hợp, nội dung vẫn hiển thị trên màn hình."
          }
        }
      }
    },
    "Start a round from Course to keep a scorecard and record GPS shots.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a round from Course to keep a scorecard and record GPS shots."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코스에서 라운드를 시작해 스코어카드와 GPS 샷을 기록하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コースからラウンドを開始して、スコアカードとGPSショットを記録しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在球场页面开始球局，即可填写记分卡并记录GPS击球。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在球場頁面開始球局，即可填寫計分卡並記錄GPS擊球。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una vuelta desde Campo para llevar la tarjeta y registrar golpes GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma rodada em Campo para manter o cartão e registrar tacadas GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Golfplatz eine Runde starten, um Scorekarte und GPS-Schläge zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une partie dans Parcours pour tenir la carte et enregistrer les coups GPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia un giro da Percorso per tenere il segnapunti e registrare colpi GPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มรอบจากสนามเพื่อใช้สกอร์การ์ดและบันทึกช็อต GPS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu vòng đấu ở Sân golf để ghi bảng điểm và cú đánh GPS."
          }
        }
      }
    },
