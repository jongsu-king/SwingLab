    "Personal estimates remain separate from recorded GPS displacement and camera analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal estimates remain separate from recorded GPS displacement and camera analysis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 추정값은 GPS 지상 변위 기록 및 카메라 분석값과 구분됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の推定値はGPS移動距離やカメラ解析の結果と区別して扱います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人估计值与 GPS 位移记录及相机分析结果分开保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人估計值與 GPS 位移紀錄及相機分析結果分開保存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones personales se distinguen del desplazamiento GPS y del análisis de cámara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativas pessoais ficam separadas do deslocamento GPS e da análise de câmera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Schätzungen bleiben von GPS-Verschiebungen und Kameraanalysen getrennt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations personnelles restent distinctes des déplacements GPS et de l’analyse vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime personali restano separate dagli spostamenti GPS e dall’analisi video."
