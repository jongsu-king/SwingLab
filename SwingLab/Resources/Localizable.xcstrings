    "Short interpolated gaps are dashed. Longer gaps are not connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short interpolated gaps are dashed. Longer gaps are not connected."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 보간 구간은 점선으로 표시합니다. 더 긴 공백은 연결하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い補間区間は破線で表示します。長い欠落区間は接続しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短暂缺失的插值区间以虚线显示。较长缺失区间不会连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短暫缺失的內插區間以虛線顯示。較長缺失區間不會連接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los huecos cortos interpolados se muestran con líneas discontinuas. Los huecos largos no se conectan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As lacunas curtas interpoladas são tracejadas. As lacunas mais longas não são conectadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze interpolierte Lücken werden gestrichelt dargestellt. Längere Lücken werden nicht verbunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les courts intervalles interpolés sont en pointillés. Les intervalles plus longs ne sont pas reliés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brevi lacune interpolate sono tratteggiate. Le lacune più lunghe non vengono collegate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงขาดหายสั้นที่เติมด้วยการประมาณค่าจะแสดงเป็นเส้นประ ส่วนช่วงขาดหายที่ยาวกว่าจะไม่เชื่อมต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng trống ngắn được nội suy hiển thị bằng nét đứt. Khoảng trống dài hơn không được nối."
          }
        }
      }
    },
