    "reference.gappingContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapping context: this group averaged a smash factor of %1$@ and a launch angle of %2$@. These values do not predict your distances or recommend a club."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리 간격 참고: 이 집단의 평균 스매시 팩터는 %1$@, 발사각은 %2$@입니다. 내 거리를 예측하거나 클럽을 추천하는 값이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離差の参考：この集団の平均ミート率は%1$@、打ち出し角は%2$@です。あなたの距離の予測やクラブの推奨ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离间隔参考：此群体平均击球效率为%1$@，发射角为%2$@。这些数值不预测你的距离，也不推荐球杆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離間隔參考：此群體平均擊球效率為%1$@，發射角為%2$@。這些數值不預測你的距離，也不推薦球桿。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto de distancias: este grupo tuvo un factor de impacto medio de %1$@ y un ángulo de lanzamiento de %2$@. No predicen tus distancias ni recomiendan un palo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto de distâncias: este grupo teve fator de impacto médio de %1$@ e ângulo de lançamento de %2$@. Esses valores não preveem suas distâncias nem recomendam um taco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext zu Distanzabständen: Diese Gruppe erreichte im Mittel einen Smash-Faktor von %1$@ und einen Abflugwinkel von %2$@. Daraus folgen keine Vorhersagen deiner Distanzen oder Schlägerempfehlungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte d’étagement : ce groupe affichait un facteur de frappe moyen de %1$@ et un angle de lancement de %2$@. Ces valeurs ne prédisent pas vos distances et ne recommandent aucun club."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contesto delle distanze: questo gruppo aveva un fattore di impatto medio di %1$@ e un angolo di lancio di %2$@. Questi valori non prevedono le tue distanze né consigliano un bastone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริบทระยะห่าง: กลุ่มนี้มีสแมชแฟกเตอร์เฉลี่ย %1$@ และมุมเหินเฉลี่ย %2$@ ค่าเหล่านี้ไม่ทำนายระยะของคุณหรือแนะนำไม้กอล์ฟ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin khoảng cách: nhóm này có hệ số truyền lực trung bình %1$@ và góc phóng %2$@. Các giá trị này không dự đoán khoảng cách của bạn hay khuyên chọn gậy."
          }
        }
      }
    },
