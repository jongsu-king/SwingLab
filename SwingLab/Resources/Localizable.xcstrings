    "coach.backswing.higher": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing took %1$@ s, longer than your recent average of %2$@ s (%3$@ swings)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백스윙 %1$@초: 최근 평균 %2$@초보다 깁니다 (스윙 %3$@개 기준)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックスイング %1$@秒：最近の平均 %2$@秒より長めです（%3$@回のスイング）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上杆用时 %1$@ 秒，长于你最近的平均值 %2$@ 秒（%3$@ 次挥杆）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上桿用時 %1$@ 秒，長於你最近的平均值 %2$@ 秒（%3$@ 次揮桿）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing de %1$@ s: más largo que tu media reciente de %2$@ s (%3$@ swings)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing de %1$@ s: mais longo que sua média recente de %2$@ s (%3$@ swings)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückschwung %1$@ s: länger als dein jüngster Durchschnitt von %2$@ s (%3$@ Schwünge)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montée de %1$@ s : plus longue que votre moyenne récente de %2$@ s (%3$@ swings)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing di %1$@ s: più lungo della tua media recente di %2$@ s (%3$@ swing)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ็กสวิง %1$@ วินาที นานกว่าค่าเฉลี่ยล่าสุดของคุณ %2$@ วินาที (%3$@ สวิง)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing %1$@ giây, dài hơn mức trung bình gần đây %2$@ giây (%3$@ cú swing)."
          }
        }
      }
    },
    "coach.backswing.lower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backswing took %1$@ s, shorter than your recent average of %2$@ s (%3$@ swings)."
