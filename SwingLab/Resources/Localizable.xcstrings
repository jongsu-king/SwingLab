    "The video could not be imported. Try a local video shorter than three minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video could not be imported. Try a local video shorter than three minutes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상을 가져오지 못했습니다. 기기에 저장된 3분 미만의 영상으로 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
