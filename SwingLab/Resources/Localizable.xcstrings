    "Session details describe the practice. Individual recording labels stay as entered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session details describe the practice. Individual recording labels stay as entered."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 정보는 해당 연습을 설명합니다. 개별 영상에 입력한 정보는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの詳細は練習全体を説明します。各録画の設定は入力したまま保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习详情用于描述本次练习。各录像的标签保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習詳情用於描述本次練習。各錄影的標籤保持原樣。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles describen la práctica. Las etiquetas de cada grabación se mantienen como se introdujeron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes descrevem o treino. Os rótulos de cada gravação permanecem como foram inseridos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben beschreiben die Trainingseinheit. Die Angaben einzelner Aufnahmen bleiben wie eingegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces détails décrivent la séance. Les libellés de chaque enregistrement restent tels qu’ils ont été saisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dettagli descrivono la pratica. Le etichette delle singole registrazioni restano come inserite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดเซสชันใช้อธิบายการฝึกซ้อม ข้อมูลกำกับของแต่ละวิดีโอยังคงตามที่ป้อนไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiết buổi tập mô tả lần luyện tập này. Nhãn của từng bản ghi được giữ nguyên như đã nhập."
          }
        }
      }
    },
    "Set Address and Top markers before tracking.": {
      "extractionState": "manual",
      "localizations": {
