    "Impact timed from the impact sound. Sound travel adds about 3 ms per metre between you and the iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Impact timed from the impact sound. Sound travel adds about 3 ms per metre between you and the iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임팩트 시점은 타구음으로 측정했습니다. 골퍼와 iPhone 사이 거리 1m마다 소리가 전달되는 데 약 3ms가 더해집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インパクトは打球音から計時しました。あなたとiPhoneの距離1メートルごとに、音が届くまで約3ミリ秒かかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球时刻由击球声测定。你与 iPhone 之间每相距 1 米，声音传播约增加 3 毫秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊球時刻由擊球聲測定。你與 iPhone 之間每相距 1 公尺，聲音傳播約增加 3 毫秒。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impacto se midió por el sonido del golpe. La propagación del sonido añade unos 3 ms por cada metro entre tú y el iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O impacto foi cronometrado pelo som da batida. A propagação do som acrescenta cerca de 3 ms por metro entre você e o iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Treffmoment wurde aus dem Schlaggeräusch bestimmt. Die Schalllaufzeit fügt etwa 3 ms pro Meter zwischen dir und dem iPhone hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impact a été chronométré d’après le son de frappe. La propagation du son ajoute environ 3 ms par mètre entre vous et l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impatto è stato misurato dal suono del colpo. La propagazione del suono aggiunge circa 3 ms per ogni metro tra te e l’iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับเวลาจังหวะกระทบจากเสียงตีลูก การเดินทางของเสียงเพิ่มเวลาประมาณ 3 มิลลิวินาทีต่อระยะ 1 เมตรระหว่างคุณกับ iPhone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm chạm bóng được đo từ tiếng đánh bóng. Âm thanh truyền đi cộng thêm khoảng 3 ms cho mỗi mét giữa bạn và iPhone."
          }
        }
      }
    },
