    "Camera and location access are requested only when you use them. No account required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and location access are requested only when you use them. No account required."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라와 위치 권한은 해당 기능을 사용할 때만 요청합니다. 계정은 필요하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラと位置情報の許可は、機能を使うときにのみ求めます。アカウントは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在使用相关功能时请求相机和位置权限。无需账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在使用相關功能時要求相機與位置權限。無需帳號。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo pedimos acceso a la cámara y la ubicación cuando los usas. No necesitas una cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera e à localização é solicitado apenas durante o uso. Não é necessário criar conta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera- und Standortzugriff werden erst bei Nutzung angefragt. Kein Konto erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la caméra et à la position n’est demandé qu’au moment de leur utilisation. Aucun compte requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a fotocamera e posizione viene richiesto solo quando serve. Non occorre un account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะขอสิทธิ์กล้องและตำแหน่งเฉพาะเมื่อใช้งาน ไม่ต้องมีบัญชี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ yêu cầu quyền camera và vị trí khi sử dụng. Không cần tài khoản."
          }
        }
      }
    },
