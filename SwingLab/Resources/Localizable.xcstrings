    "Several similar sounds after the top, so impact is a pose estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several similar sounds after the top, so impact is a pose estimate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탑 이후 비슷한 소리가 여러 번 들려 임팩트는 자세 기반 추정입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トップの後に似た音が複数あるため、インパクトは姿勢からの推定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上杆顶点之后有多个相似的声音，击球时刻为姿态估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上桿頂點之後有多個相似的聲音，擊球時刻為姿態估算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay varios sonidos parecidos después del punto más alto, así que el impacto es una estimación por postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há vários sons parecidos após o topo, então o impacto é uma estimativa pela postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem höchsten Punkt gibt es mehrere ähnliche Geräusche, daher ist der Treffmoment eine Schätzung aus der Haltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs sons similaires après le haut du swing ; l’impact est une estimation d’après la posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono diversi suoni simili dopo la sommità, quindi l’impatto è una stima dalla postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเสียงคล้ายกันหลายครั้งหลังจุดสูงสุด จังหวะกระทบจึงเป็นค่าประมาณจากท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có nhiều âm thanh giống nhau sau đỉnh swing, nên thời điểm chạm bóng là ước tính từ tư thế."
          }
        }
      }
    },
