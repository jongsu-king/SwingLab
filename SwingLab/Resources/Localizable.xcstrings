    "Your videos and golf records stay on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos and golf records stay on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상과 골프 기록은 이 iPhone에 저장됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画とゴルフの記録はこのiPhoneに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频和高尔夫记录保存在这部 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片與高爾夫紀錄儲存在這部 iPhone 上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus vídeos y registros de golf se guardan en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus vídeos e registros de golfe ficam neste iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Videos und Golfdaten bleiben auf diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos vidéos et vos données de golf restent sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi video e i dati di golf restano su questo iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอและบันทึกกอล์ฟจะเก็บไว้บน iPhone เครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video và dữ liệu golf được lưu trên iPhone này."
          }
        }
      }
    },
    "Your videos, club details, course notes, and round records are saved locally. Swing analysis runs on the iPhone. This version does not upload your videos or require an account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos, club details, course notes, and round records are saved locally. Swing analysis runs on the iPhone. This version does not upload your videos or require an account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상, 클럽 정보, 코스 메모, 라운드 기록은 기기에 저장됩니다. 스윙 분석은 iPhone에서 실행됩니다. 이 버전은 영상을 업로드하지 않으며 계정도 필요하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画、クラブ情報、コースメモ、ラウンド記録はデバイス内に保存されます。解析はiPhone上で行います。このバージョンは動画をアップロードせず、アカウントも不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频、球杆详情、球场备注和轮次记录保存在本地。挥杆分析在 iPhone 上运行。此版本不会上传视频，也不需要账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片、球桿詳情、球場備註和回合紀錄儲存在本機。揮桿分析在 iPhone 上執行。此版本不會上傳影片，也不需要帳號。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus vídeos, palos, notas y rondas se guardan localmente. El análisis se ejecuta en el iPhone. Esta versión no sube tus vídeos ni requiere cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos, detalhes dos tacos, notas de campo e rodadas ficam locais. A análise roda no iPhone. Esta versão não envia vídeos nem exige conta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, Schlägerdaten, Platznotizen und Runden werden lokal gespeichert. Die Schwunganalyse läuft auf dem iPhone. Diese Version lädt keine Videos hoch und benötigt kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos vidéos, clubs, notes de parcours et parties sont enregistrés localement. L’analyse s’exécute sur l’iPhone. Cette version n’envoie pas vos vidéos et ne nécessite aucun compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, dettagli dei bastoni, note sui campi e giri vengono salvati localmente. L’analisi avviene su iPhone. Questa versione non carica video né richiede un account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอ ข้อมูลไม้ โน้ตสนาม และรอบเก็บในเครื่อง วิเคราะห์สวิงบน iPhone เวอร์ชันนี้ไม่อัปโหลดวิดีโอและไม่ต้องมีบัญชี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, chi tiết gậy, ghi chú sân và vòng chơi được lưu cục bộ. Phân tích swing chạy trên iPhone. Phiên bản này không tải video lên hay yêu cầu tài khoản."
          }
        }
      }
    },
