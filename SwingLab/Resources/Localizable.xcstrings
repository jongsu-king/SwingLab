    "metric.regionCondition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional on your entered club profile; not a calibrated guarantee."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 클럽 프로필을 전제로 하며, 실측으로 검증된 보장이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したクラブ情報に基づく条件付きの範囲であり、実測で検証された保証ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以您输入的球杆资料为前提，并非经校准验证的保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以您輸入的球桿資料為前提，並非經校準驗證的保證。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depende del perfil de palo que has introducido; no es una garantía calibrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depende do perfil de taco informado; não é uma garantia calibrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängig von Ihrem eingegebenen Schlägerprofil; keine durch Messungen bestätigte Garantie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditionnel aux données du club que vous avez saisies ; ne constitue pas une garantie étalonnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipende dal profilo del bastone inserito; non è una garanzia verificata tramite calibrazione."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้นอยู่กับข้อมูลไม้กอล์ฟที่คุณป้อน ไม่ใช่การรับประกันที่ผ่านการสอบเทียบ"
          }
        },
        "vi": {
