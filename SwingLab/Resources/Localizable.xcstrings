    "GPS is stale or too uncertain for shot recording. Refresh GPS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS is stale or too uncertain for shot recording. Refresh GPS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS가 오래되었거나 정확도가 낮아 샷을 기록할 수 없습니다. GPS를 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSが古いか精度不足のため記録できません。GPSを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS定位过旧或精度不足，无法记录击球。请刷新GPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS定位過舊或精度不足，無法記錄擊球。請更新GPS。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS antiguo o impreciso para registrar golpes. Actualiza el GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS antigo ou impreciso para registrar tacadas. Atualize o GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS zu alt oder ungenau für Schlagaufzeichnung. GPS aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS trop ancien ou imprécis pour enregistrer un coup. Actualisez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS datato o impreciso per registrare il colpo. Aggiorna il GPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS เก่าหรือคลาดเคลื่อนเกินไปสำหรับบันทึกช็อต โปรดอัปเดต GPS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS đã cũ hoặc quá thiếu chính xác để ghi cú đánh. Hãy làm mới GPS."
          }
        }
      }
    },
