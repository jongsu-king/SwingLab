          }
        }
      }
    },
    "The distance between two recorded positions is ground displacement. It includes location uncertainty and is not measured airborne carry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distance between two recorded positions is ground displacement. It includes location uncertainty and is not measured airborne carry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 두 위치 사이 거리는 지상 변위입니다. 위치 오차가 포함되며 공중 캐리 측정값이 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した2地点間の距離は地上の移動距離です。位置の誤差を含み、空中のキャリー測定ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个记录位置之间的距离是地面位移，包含定位误差，并非测得的空中飞行距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個記錄位置之間的距離是地面位移，包含定位誤差，並非測得的空中飛行距離。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia entre dos posiciones es desplazamiento terrestre. Incluye incertidumbre de ubicación y no mide la distancia de vuelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância entre duas posições é deslocamento no solo. Inclui incerteza de localização e não mede a distância aérea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abstand zweier gespeicherter Positionen ist Bodenverschiebung. Er enthält Standortunsicherheit und ist kein gemessener Carry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance entre deux positions est un déplacement au sol. Elle inclut l’incertitude de localisation et ne mesure pas la portée en vol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza tra due posizioni è uno spostamento al suolo. Include l’incertezza della posizione e non misura la distanza in volo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะระหว่างตำแหน่งสองจุดคือระยะบนพื้น มีความคลาดเคลื่อนตำแหน่งและไม่ใช่ระยะลอยที่วัดได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách giữa hai vị trí là độ dịch chuyển trên mặt đất, có sai số định vị và không phải khoảng cách bay đo được."
          }
        }
      }
    },
    "The impact sound was too faint or out of order, so impact stays a pose estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The impact sound was too faint or out of order, so impact stays a pose estimate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타구음이 너무 작거나 순서가 맞지 않아 임팩트는 자세 기반 추정으로 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打球音が小さすぎるか順序が合わないため、インパクトは姿勢からの推定のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击球声太弱或时间顺序不符，击球时刻仍为姿态估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊球聲太弱或時間順序不符，擊球時刻仍為姿態估算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido del impacto era demasiado débil o no encajaba en el orden, así que el impacto sigue siendo una estimación por postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do impacto estava fraco demais ou fora de ordem, então o impacto continua sendo uma estimativa pela postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlaggeräusch war zu leise oder passte nicht in die Abfolge, daher bleibt der Treffmoment eine Schätzung aus der Haltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son d’impact était trop faible ou mal placé dans la séquence ; l’impact reste une estimation d’après la posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono dell’impatto era troppo debole o fuori sequenza, quindi l’impatto resta una stima dalla postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงกระทบเบาเกินไปหรือไม่ตรงลำดับ จังหวะกระทบจึงยังเป็นค่าประมาณจากท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếng chạm bóng quá nhỏ hoặc sai thứ tự, nên thời điểm chạm bóng vẫn là ước tính từ tư thế."
          }
        }
      }
    },
    "The loudest sound did not match the swing timing, so impact is a pose estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The loudest sound did not match the swing timing, so impact is a pose estimate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 소리가 스윙 타이밍과 맞지 않아 임팩트는 자세 기반 추정입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も大きな音がスイングのタイミングと合わないため、インパクトは姿勢からの推定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最响的声音与挥杆时机不符，击球时刻为姿态估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最響的聲音與揮桿時機不符，擊球時刻為姿態估算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido más fuerte no coincidía con el ritmo del swing, así que el impacto es una estimación por postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som mais alto não coincidiu com o tempo do swing, então o impacto é uma estimativa pela postura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lauteste Geräusch passte nicht zum Schwung-Timing, daher ist der Treffmoment eine Schätzung aus der Haltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son le plus fort ne correspondait pas au rythme du swing ; l’impact est une estimation d’après la posture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono più forte non corrispondeva ai tempi dello swing, quindi l’impatto è una stima dalla postura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่ดังที่สุดไม่ตรงกับจังหวะสวิง จังหวะกระทบจึงเป็นค่าประมาณจากท่าทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh lớn nhất không khớp với nhịp swing, nên thời điểm chạm bóng là ước tính từ tư thế."
          }
        }
      }
    },
    "The measured motion is not plausible for a struck ball, so no value is shown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measured motion is not plausible for a struck ball, so no value is shown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정된 움직임이 타구된 공으로 보기 어려워 값을 표시하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定された動きは打たれたボールとして妥当でないため、値を表示しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测得的运动不符合被击出的球，因此不显示数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測得的運動不符合被擊出的球，因此不顯示數值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento medido no es plausible para una bola golpeada, así que no se muestra ningún valor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento medido não é plausível para uma bola golpeada, então nenhum valor é exibido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gemessene Bewegung ist für einen geschlagenen Ball nicht plausibel, daher wird kein Wert angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement mesuré n’est pas plausible pour une balle frappée ; aucune valeur n’est affichée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il movimento misurato non è plausibile per una palla colpita, quindi non viene mostrato alcun valore."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเคลื่อนที่ที่วัดได้ไม่สมเหตุสมผลสำหรับลูกที่ถูกตี จึงไม่แสดงค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển động đo được không hợp lý với một quả bóng được đánh, nên không hiển thị giá trị."
          }
        }
      }
    },
